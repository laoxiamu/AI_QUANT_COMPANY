   114	def extract_phase(name: str, text: str) -> str | None:
   115	    if name == "CURRENT_STATE":
   116	        for line in text.splitlines():
   117	            if "阶段" in line:
   118	                match = re.search(r"Phase\s*([0-9][AB]?)", line, re.I)
   119	                if match:
   120	                    return f"Phase {match.group(1)}"
   121	
   122	    if name == "BOOT_BRIEF":
   123	        for line in text.splitlines()[:15]:
   124	            match = re.search(r"\bPhase\s*([0-9][AB]?)\b", line, re.I)
   125	            if match:
   126	                return f"Phase {match.group(1)}"
   127	
   128	    if name == "TASK_PLAN":
   129	        lines = text.splitlines()
   130	        focus_lines = []
   131	        used_focus_section = False
   132	        for idx, line in enumerate(lines):
   133	            if "当前焦点" in line:
   134	                used_focus_section = True
   135	                for focus_line in lines[idx + 1:]:
   136	                    if focus_line.startswith("## "):
   137	                        break
   138	                    focus_lines.append(focus_line)
   139	                break
   140	        scan_lines = focus_lines if focus_lines else lines[:50]
   141	        for line in scan_lines:
   142	            if re.search(r"Phase\s*[0-9]\s*[-~—]\s*[0-9]", line, re.I):
   143	                continue
   144	            if re.match(r"#+\s*Phase\s+[0-9]", line, re.I):
   145	                continue
   146	            match = re.search(r"\bPhase\s*([0-9][AB]?)\b", line, re.I)
   147	            if match:
   148	                return f"Phase {match.group(1)}"
   149	        if used_focus_section:
   150	            return None
   151	
   152	    match = re.search(r"\bPhase\s*([0-9][AB]?)\b|阶段\s*([0-9][AB]?)", text, re.I)
   153	    if match:
   154	        return f"Phase {match.group(1) or match.group(2)}"
   155	    return None
