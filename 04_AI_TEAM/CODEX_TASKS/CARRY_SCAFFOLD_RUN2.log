   130	        for variant, results in variants.items()
   131	    }
     1	"""Acceptance-input metrics and auditable bootstrap helpers."""
     2	
     3	from __future__ import annotations
     4	
     5	import math
     6	from typing import Iterable
     7	
     8	import numpy as np
     9	import pandas as pd
    10	
    11	
    12	def _return_series(values: Iterable[float] | pd.Series) -> pd.Series:
    13	    series = pd.Series(values, copy=True, dtype=float).dropna()
    14	    if ((series <= -1.0)).any():
    15	        raise ValueError("returns must be greater than -1")
    16	    return series
    17	
    18	
    19	def compute_metrics(returns: pd.Series) -> dict[str, float | int]:
    20	    series = _return_series(returns)
    21	    if series.empty:
    22	        raise ValueError("returns must not be empty")
    23	    positive_sum = float(series[series > 0].sum())
    24	    negative_sum = float(-series[series < 0].sum())
    25	    profit_factor = (
    26	        positive_sum / negative_sum if negative_sum > 0 else math.inf
    27	    )
    28	    equity = (1.0 + series).cumprod()
    29	    drawdown = equity / equity.cummax() - 1.0
    30	
    31	    if isinstance(returns.index, pd.DatetimeIndex):
    32	        index = pd.DatetimeIndex(returns.loc[series.index].index)
    33	        if index.tz is None:
    34	            index = index.tz_localize("UTC")
    35	        elapsed_years = max(
    36	            (index.max() - index.min()).total_seconds()
    37	            / (365.2425 * 24 * 60 * 60),
    38	            1.0 / 365.2425,
    39	        )
    40	        annualized_log_growth = float(np.log1p(series).sum() / elapsed_years)
    41	        annual_returns = (1.0 + series).groupby(index.year).prod() - 1.0
    42	        positive_year_ratio = float((annual_returns > 0).mean())
    43	    else:
    44	        annualized_log_growth = float(np.log1p(series).mean())
    45	        positive_year_ratio = float("nan")
    46	
    47	    return {
    48	        "net_expected_return": float(series.mean()),
    49	        "profit_factor": float(profit_factor),
    50	        "positive_year_ratio": positive_year_ratio,
    51	        "annualized_log_growth": annualized_log_growth,
    52	        "geometric_growth": float(math.expm1(annualized_log_growth)),
    53	        "max_drawdown": float(drawdown.min()),
    54	        "observations": int(len(series)),
    55	    }
    56	
    57	
    58	def three_way_walk_forward(returns: pd.Series) -> list[dict[str, float | int]]:
    59	    if not isinstance(returns.index, pd.DatetimeIndex):
    60	        raise TypeError("walk-forward returns must use a DatetimeIndex")
    61	    series = _return_series(returns.sort_index())
    62	    if len(series) < 3:
    63	        raise ValueError("at least three observations are required")
    64	    index = pd.DatetimeIndex(series.index)
    65	    start = index.min()
    66	    span = index.max() - start
    67	    boundaries = (start + span / 3, start + span * 2 / 3)
    68	    masks = (
    69	        index < boundaries[0],
    70	        (index >= boundaries[0]) & (index < boundaries[1]),
    71	        index >= boundaries[1],
    72	    )
    73	    output: list[dict[str, float | int]] = []
    74	    for number, mask in enumerate(masks, start=1):
    75	        segment = series.loc[mask]
    76	        if segment.empty:
    77	            raise ValueError("time-based walk-forward produced an empty segment")
    78	        metrics = compute_metrics(segment)
    79	        output.append({"segment": number, **metrics})
    80	    return output
    81	
    82	
    83	def moving_block_bootstrap_pvalue(
    84	    values: Iterable[float],
    85	    *,
    86	    block_size: int = 9,
    87	    iterations: int = 10_000,
    88	    seed: int = 20260615,
    89	) -> dict[str, float | int]:
    90	    sample = np.asarray(list(values), dtype=float)
    91	    sample = sample[np.isfinite(sample)]
    92	    if len(sample) < 2:
    93	        raise ValueError("at least two finite values are required")
    94	    if not 1 <= block_size <= len(sample):
    95	        raise ValueError("block_size must be between 1 and sample length")
    96	    if iterations <= 0:
    97	        raise ValueError("iterations must be positive")
    98	
    99	    observed = float(sample.mean())
   100	    centered = sample - observed
   101	    rng = np.random.default_rng(seed)
   102	    blocks_needed = math.ceil(len(sample) / block_size)
   103	    bootstrap_means = np.empty(iterations)
   104	    offsets = np.arange(block_size)
   105	    for iteration in range(iterations):
   106	        starts = rng.integers(0, len(sample), size=blocks_needed)
   107	        indices = (starts[:, None] + offsets) % len(sample)
   108	        draw = centered[indices.ravel()[: len(sample)]]
   109	        bootstrap_means[iteration] = draw.mean()
   110	    p_value = (1 + int((bootstrap_means >= observed).sum())) / (
   111	        iterations + 1
   112	    )
   113	    return {
   114	        "observed_mean": observed,
   115	        "p_value": float(p_value),
   116	        "block_size": block_size,
   117	        "iterations": iterations,
   118	        "seed": seed,
   119	    }
   120	
   121	
   122	def cluster_bootstrap_pvalue(
   123	    values: Iterable[float],
   124	    clusters: Iterable[object],
   125	    *,
   126	    iterations: int = 10_000,
   127	    seed: int = 20260615,
   128	) -> dict[str, float | int]:
   129	    frame = pd.DataFrame({"value": list(values), "cluster": list(clusters)})
   130	    frame = frame.dropna(subset=["value", "cluster"])
   131	    if frame.empty:
   132	        raise ValueError("cluster sample must not be empty")
   133	    observed = float(frame["value"].mean())
   134	    frame["centered"] = frame["value"] - observed
   135	    groups = [
   136	        group["centered"].to_numpy(dtype=float)
   137	        for _, group in frame.groupby("cluster", sort=False)
   138	    ]
   139	    rng = np.random.default_rng(seed)
   140	    bootstrap_means = np.empty(iterations)
   141	    for iteration in range(iterations):
   142	        selected = rng.integers(0, len(groups), size=len(groups))
   143	        draw = np.concatenate([groups[index] for index in selected])
   144	        bootstrap_means[iteration] = draw.mean()
   145	    p_value = (1 + int((bootstrap_means >= observed).sum())) / (
   146	        iterations + 1
   147	    )
   148	    return {
   149	        "observed_mean": observed,
   150	        "p_value": float(p_value),
   151	        "clusters": len(groups),
   152	        "iterations": iterations,
   153	        "seed": seed,
   154	    }
