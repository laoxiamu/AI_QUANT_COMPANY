    10	@dataclass(frozen=True)
    11	class TriggerSchedule:
    12	    scale: pd.Series
    13	    events: pd.DataFrame
    14	
    15	
    16	def build_refractory_schedule(
    17	    oi_percentile: pd.Series,
    18	    *,
    19	    threshold: float = 0.01,
    20	    reduced_scale: float = 0.5,
    21	    refractory: str | pd.Timedelta = "24h",
    22	) -> TriggerSchedule:
    23	    """Reduce at a trigger timestamp and ignore retriggers until expiry."""
    24	    if not isinstance(oi_percentile.index, pd.DatetimeIndex):
    25	        raise TypeError("oi_percentile must use a DatetimeIndex")
    26	    if not 0 <= threshold <= 1:
    27	        raise ValueError("threshold must be in [0, 1]")
    28	    if not 0 < reduced_scale <= 1:
    29	        raise ValueError("reduced_scale must be in (0, 1]")
    30	    duration = pd.Timedelta(refractory)
    31	    if duration <= pd.Timedelta(0):
    32	        raise ValueError("refractory must be positive")
    33	
    34	    values = oi_percentile.sort_index().copy()
    35	    if values.index.tz is None:
    36	        values.index = values.index.tz_localize("UTC")
    37	    else:
    38	        values.index = values.index.tz_convert("UTC")
    39	
    40	    active_until: pd.Timestamp | None = None
    41	    scales: list[float] = []
    42	    event_rows: list[dict[str, object]] = []
    43	    for timestamp, value in values.items():
    44	        active = active_until is not None and timestamp < active_until
    45	        if not active and pd.notna(value) and float(value) <= threshold:
    46	            active_until = timestamp + duration
    47	            active = True
    48	            event_rows.append(
    49	                {
    50	                    "timestamp": timestamp,
    51	                    "oi_percentile": float(value),
    52	                    "active_until": active_until,
    53	                    "target_scale": reduced_scale,
    54	                }
    55	            )
    56	        scales.append(reduced_scale if active else 1.0)
    57	
    58	    events = pd.DataFrame(
    59	        event_rows,
    60	        columns=[
    61	            "timestamp",
    62	            "oi_percentile",
    63	            "active_until",
    64	            "target_scale",
    65	        ],
    66	    )
    67	    return TriggerSchedule(
    68	        scale=pd.Series(scales, index=values.index, name="target_scale"),
    69	        events=events,
    70	    )

