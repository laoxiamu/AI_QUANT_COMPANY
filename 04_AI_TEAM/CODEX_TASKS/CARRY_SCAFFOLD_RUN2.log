    28	def authorization_errors(args: argparse.Namespace) -> list[str]:
    29	    required = (
    30	        ("confirm_prereg_approved", "blind review approval is not confirmed"),
    31	        ("confirm_holdout_sealed", "custodian Holdout seal is not confirmed"),
    32	        ("confirm_preholdout_only", "pre-holdout-only execution is not confirmed"),
    33	    )
    34	    return [
    35	        message for attribute, message in required if not getattr(args, attribute)
    36	    ]
