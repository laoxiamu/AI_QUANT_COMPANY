+def test_low_oi_percentile_reduces_position_for_24h_without_extension() -> None:
+    index = pd.date_range("2024-01-01", periods=6, freq="6h", tz="UTC")
+    percentile = pd.Series(
+        [0.50, 0.01, 0.005, 0.50, 0.50, 0.50],
