    42	def _read_and_normalize(
    43	    path: Path,
    44	    *,
    45	    value_aliases: tuple[str, ...],
    46	    value_name: str,
    47	    cutoff: pd.Timestamp,
    48	) -> tuple[pd.DataFrame, dict[str, int | str]]:
    49	    raw_rows = _nonempty_data_rows(path)
    50	    raw = pd.read_csv(path, on_bad_lines="skip")
    51	    parsed_rows = len(raw)
    52	    time_col = _pick_column(raw.columns, TIME_ALIASES, "timestamp")
    53	    value_col = _pick_column(raw.columns, value_aliases, value_name)
    54	
    55	    normalized = pd.DataFrame(
    56	        {
    57	            "timestamp": pd.to_datetime(
    58	                raw[time_col],
    59	                utc=True,
    60	                errors="coerce",
    61	            ),
    62	            value_name: pd.to_numeric(raw[value_col], errors="coerce"),
    63	        }
    64	    )
    65	    valid_mask = normalized["timestamp"].notna() & normalized[value_name].notna()
    66	    invalid_rows = raw_rows - int(valid_mask.sum())
    67	    normalized = normalized.loc[valid_mask].copy()
    68	    cutoff_rows = int((normalized["timestamp"] >= cutoff).sum())
    69	    normalized = normalized.loc[normalized["timestamp"] < cutoff]
    70	    duplicate_rows = int(normalized["timestamp"].duplicated(keep="last").sum())
    71	    normalized = (
    72	        normalized.drop_duplicates("timestamp", keep="last")
    73	        .sort_values("timestamp")
    74	        .reset_index(drop=True)
    75	    )
    76	    audit: dict[str, int | str] = {
    77	        "path": str(path),
    78	        "raw_rows": raw_rows,
    79	        "parsed_rows": parsed_rows,
    80	        "invalid_rows": invalid_rows,
    81	        "cutoff_rows": cutoff_rows,
    82	        "duplicate_rows": duplicate_rows,
    83	        "output_rows": len(normalized),
    84	    }
