    39	def _load_oi_percentile(
    40	    path: Path,
    41	    *,
    42	    cutoff: pd.Timestamp,
    43	) -> pd.Series:
    44	    frame = pd.read_csv(path, on_bad_lines="skip")
    45	    time_col = next(
    46	        (
    47	            name
    48	            for name in ("timestamp", "datetime", "ts", "time")
    49	            if name in frame.columns
    50	        ),
    51	        None,
    52	    )
    53	    value_col = next(
    54	        (
    55	            name
    56	            for name in (
    57	                "d6h_rolling_pctl",
    58	                "oi_percentile",
    59	                "percentile",
    60	            )
    61	            if name in frame.columns
    62	        ),
    63	        None,
    64	    )
    65	    if time_col is None or value_col is None:
    66	        raise ValueError(f"{path} missing OI timestamp/percentile columns")
    67	    timestamp = pd.to_datetime(frame[time_col], utc=True, errors="coerce")
    68	    value = pd.to_numeric(frame[value_col], errors="coerce")
    69	    valid = timestamp.notna() & value.notna() & (timestamp < cutoff)
    70	    series = pd.Series(
    71	        value.loc[valid].to_numpy(dtype=float),
    72	        index=pd.DatetimeIndex(timestamp.loc[valid]),
    73	        name="oi_percentile",
    74	    )
    75	    return series[~series.index.duplicated(keep="last")].sort_index()
    76	
    77	
    78	def build_parser() -> argparse.ArgumentParser:
    79	    parser = argparse.ArgumentParser(
    80	        description="Run the approved pre-holdout carry comparison."
    81	    )
    82	    parser.add_argument("--data-dir", type=Path, required=True)
    83	    parser.add_argument("--btc-oi", type=Path, required=True)
    84	    parser.add_argument("--eth-oi", type=Path, required=True)
    85	    parser.add_argument("--cutoff", default=str(DEFAULT_CUTOFF))
    86	    parser.add_argument("--base-notional", type=float, default=100_000.0)
    87	    parser.add_argument("--leverage", type=float, default=2.0)
    88	    parser.add_argument("--minimum-maintenance-rate", type=float, default=0.005)
    89	    parser.add_argument("--event-slippage-rate", type=float, default=0.003)
    90	    parser.add_argument("--bootstrap-block-size", type=int, default=9)
    91	    parser.add_argument("--bootstrap-iterations", type=int, default=10_000)
    92	    parser.add_argument("--seed", type=int, default=20260615)
    93	    parser.add_argument("--output", type=Path, default=DEFAULT_OUTPUT)
    94	    parser.add_argument("--confirm-prereg-approved", action="store_true")
    95	    parser.add_argument("--confirm-holdout-sealed", action="store_true")
    96	    parser.add_argument("--confirm-preholdout-only", action="store_true")
    97	    return parser
    98	
    99	
   100	def _variant_payload(
   101	    result,
   102	    *,
   103	    block_size: int,
   104	    iterations: int,
   105	    seed: int,
   106	) -> dict[str, object]:
   107	    equity = result.timeline.set_index("timestamp")["equity"]
   108	    returns = equity.pct_change().dropna()
   109	    payload: dict[str, object] = {
   110	        "summary": result.summary,
   111	        "metrics": compute_metrics(returns) if not returns.empty else None,
   112	        "walk_forward": (
   113	            three_way_walk_forward(returns) if len(returns) >= 3 else None
   114	        ),
   115	        "events": result.events.to_dict(orient="records"),
   116	    }
   117	    if len(returns) >= 2:
   118	        payload["block_bootstrap"] = moving_block_bootstrap_pvalue(
   119	            returns.to_numpy(),
   120	            block_size=min(block_size, len(returns)),
   121	            iterations=iterations,
   122	            seed=seed,
   123	        )
   124	    else:
   125	        payload["block_bootstrap"] = None
   126	    return payload
   127	
   128	
   129	def main(argv: list[str] | None = None) -> int:
   130	    parser = build_parser()
   131	    args = parser.parse_args(argv)
