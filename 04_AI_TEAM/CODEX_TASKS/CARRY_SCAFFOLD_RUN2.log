   145	            spot,
   146	            on="timestamp",
   147	            how="left",
   148	        )
   149	        mark["spot_price"] = mark["spot_price"].fillna(mark["mark_price"])
   150	
   151	    return SymbolData(
   152	        symbol=normalized_symbol,
   153	        funding=funding,
   154	        mark=mark,
   155	        audit={"funding": funding_audit, "mark": mark_audit},
   156	    )
