     2	
     3	from __future__ import annotations
     4	
     5	from dataclasses import dataclass
     6	
     7	
     8	@dataclass(frozen=True)
     9	class CostBreakdown:
    10	    fee: float
    11	    slippage: float
    12	
    13	    @property
    14	    def total(self) -> float:
    15	        return self.fee + self.slippage
    16	
    17	
    18	@dataclass(frozen=True)
    19	class CostModel:
    20	    """Frozen fee/slippage rates applied to absolute traded notional."""
    21	
    22	    fee_rate: float = 0.001
    23	    slippage_rate: float = 0.001
    24	    event_slippage_rate: float = 0.003
    25	
    26	    def __post_init__(self) -> None:
    27	        for name, value in (
    28	            ("fee_rate", self.fee_rate),
    29	            ("slippage_rate", self.slippage_rate),
    30	            ("event_slippage_rate", self.event_slippage_rate),
    31	        ):
    32	            if value < 0:
    33	                raise ValueError(f"{name} must be non-negative")
    34	
    35	    def trade_cost(
    36	        self,
    37	        *,
    38	        spot_turnover: float,
    39	        perp_turnover: float,
    40	        event: bool = False,
    41	    ) -> CostBreakdown:
    42	        if spot_turnover < 0 or perp_turnover < 0:
    43	            raise ValueError("turnover must be non-negative")
    44	        total_turnover = spot_turnover + perp_turnover
    45	        slippage_rate = (
    46	            self.event_slippage_rate if event else self.slippage_rate
    47	        )
    48	        return CostBreakdown(
    49	            fee=total_turnover * self.fee_rate,
    50	            slippage=total_turnover * slippage_rate,
    51	        )
    52	
    53	    @staticmethod
    54	    def basis_cost(
    55	        *,
    56	        notional: float,
    57	        entry_basis_rate: float = 0.0,
    58	        exit_basis_rate: float = 0.0,
    59	    ) -> float:
    60	        if notional < 0:
    61	            raise ValueError("notional must be non-negative")
    62	        return notional * (
    63	            abs(float(entry_basis_rate)) + abs(float(exit_basis_rate))
    64	        )
