   120	        directory / f"{normalized_symbol}_MARK_1H.csv",
   121	        on_bad_lines="skip",
   122	    )
   123	    spot_col = next(
   124	        (name for name in SPOT_ALIASES if name in raw_mark.columns),
   125	        None,
   126	    )
   127	    if spot_col is not None:
   128	        time_col = _pick_column(raw_mark.columns, TIME_ALIASES, "timestamp")
   129	        spot = pd.DataFrame(
   130	            {
   131	                "timestamp": pd.to_datetime(
   132	                    raw_mark[time_col],
   133	                    utc=True,
   134	                    errors="coerce",
   135	                ),
   136	                "spot_price": pd.to_numeric(
   137	                    raw_mark[spot_col],
   138	                    errors="coerce",
   139	                ),
   140	            }
   141	        ).dropna()
   142	        spot = spot.loc[spot["timestamp"] < cutoff_ts]
