+
+    events = pd.DataFrame(
+        event_rows,
+        columns=[
+            "timestamp",
+            "oi_percentile",
+            "active_until",
+            "target_scale",
+        ],
+    )
+    return TriggerSchedule(
+        scale=pd.Series(scales, index=values.index, name="target_scale"),
+        events=events,
+    )

