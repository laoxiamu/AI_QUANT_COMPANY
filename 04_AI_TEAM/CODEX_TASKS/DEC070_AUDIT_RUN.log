/bin/bash -lc "python3 - <<'PY'
from pathlib import Path
import pandas as pd
import numpy as np
root=Path('06_RESEARCH/DATA/FUTURES_EXPANDED')
rows=[]
for p in sorted(root.glob('*_4H.csv')):
    df=pd.read_csv(p)
    df['datetime']=pd.to_datetime(df['datetime'], utc=True)
    df=df.sort_values('datetime')
    px=pd.to_numeric(df['close'], errors='coerce')
    vol=pd.to_numeric(df['volume'], errors='coerce')
    notional=(px*vol)
    daily=pd.DataFrame({'date':df['datetime'].dt.floor('D'),'notional':notional}).groupby('date')['notional'].sum(min_count=1)
    end=df['datetime'].max().floor('D')
    recent=daily[daily.index >= end-pd.Timedelta(days=179)]
    r=np.log(px).diff().replace([np.inf,-np.inf],np.nan).dropna()
    vals={'sym':p.stem.replace('_4H',''),'n':len(df),'days':len(daily),'full_m':daily.median(),'r180_m':recent.median(),'r180_days':len(recent),'valid_r':len(r)}
    for t in (.10,.15,.20):
        c=int((r.abs()>t).sum())
        vals[f'j{int(t*100)}c']=c
        vals[f'j{int(t*100)}f']=c/len(r)
    rows.append(vals)
out=pd.DataFrame(rows).sort_values('r180_m')
with pd.option_context('display.max_rows',100,'display.max_columns',20,'display.width',220,'display.float_format',lambda x:f'{x:,.6g}'):
    print(out.to_string(index=False))
print('\\nCOUNTS recent thresholds')
for x in (5e6,10e6,20e6,50e6): print(x, int((out.r180_m>=x).sum()))
print('jump15 freq percentiles', out.j15f.quantile([0,.25,.5,.75,.9,.95,1]).to_dict())
for x in (.0005,.001,.0015,.002,.003): print('jump<=',x,int((out.j15f<=x).sum()))
