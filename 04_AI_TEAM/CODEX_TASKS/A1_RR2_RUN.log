    34	
    35	def empirical_percentile(prior_values: pd.Series, value: float) -> float:
    36	    """Midrank percentile of value against prior observations only."""
    37	    lower = (prior_values < value).sum()
    38	    equal = (prior_values == value).sum()
    39	    return float((lower + 0.5 * equal) / len(prior_values))
    40	
    41	
    42	def add_rolling_percentiles(
    43	    funding: pd.DataFrame,
    44	    *,
    45	    time_col: str = "datetime",
    46	    value_col: str = FUNDING_COLUMN,
    47	) -> pd.DataFrame:
    48	    """Add no-lookahead rolling percentiles and warmup flags.
    49	
    50	    The percentile for row t uses observations with timestamps in
    51	    [t - 365 days, t). During the first year this is an expanding window,
    52	    but rows with less than 180 calendar days of prior history are warmup.
    53	    """
    54	    df = funding.sort_values(time_col).reset_index(drop=True).copy()
    55	    times = pd.to_datetime(df[time_col], utc=True)
    56	    values = df[value_col].astype(float)
    57	    percentiles: list[float | None] = []
    58	    warmup: list[bool] = []
    59	
    60	    left = 0
    61	    for idx, current_time in enumerate(times):
    62	        cutoff = current_time - pd.Timedelta(days=WINDOW_DAYS)
    63	        while left < idx and times.iloc[left] < cutoff:
    64	            left += 1
    65	
    66	        prior_times = times.iloc[left:idx]
    67	        prior_values = values.iloc[left:idx]
    68	        has_min_history = (
    69	            len(prior_times) > 0
    70	            and prior_times.iloc[0] <= current_time - pd.Timedelta(days=MIN_HISTORY_DAYS)
    71	        )
    72	        is_warmup = not has_min_history
    73	        warmup.append(is_warmup)
    74	        if is_warmup:
    75	            percentiles.append(None)
    76	        else:
    77	            percentiles.append(empirical_percentile(prior_values, values.iloc[idx]))
    78	
    79	    df["event_time"] = times.dt.strftime("%Y-%m-%dT%H:%M:%SZ")
    80	    df["rolling_pctl"] = percentiles
    81	    df["warmup"] = warmup
    82	    return df
    83	
    84	
    85	def merge_extreme_readings(readings: pd.DataFrame) -> pd.DataFrame:
    86	    """Collapse same-symbol/same-side/same-tier readings within 24h."""
    87	    if readings.empty:
    88	        return readings.loc[:, OUTPUT_COLUMNS].copy()
    89	
    90	    rows = readings.sort_values("event_time_dt").to_dict("records")
    91	    events: list[dict[str, object]] = []
    92	    last_reading_time: pd.Timestamp | None = None
    93	    for row in rows:
    94	        reading_time = row["event_time_dt"]
    95	        if last_reading_time is not None and reading_time - last_reading_time <= MERGE_WINDOW:
    96	            last_reading_time = reading_time
    97	            continue
    98	        events.append(row)
    99	        last_reading_time = reading_time
   100	
   101	    return pd.DataFrame(events).loc[:, OUTPUT_COLUMNS]
   102	
   103	
   104	def extract_symbol_events(symbol: str, funding: pd.DataFrame) -> tuple[pd.DataFrame, int]:
   105	    featured = add_rolling_percentiles(funding)
   106	    featured["symbol"] = symbol
   107	    featured["funding_value"] = featured[FUNDING_COLUMN].astype(float)
   108	    featured["event_time_dt"] = pd.to_datetime(featured["event_time"], utc=True)
   109	    usable = featured.loc[~featured["warmup"]].copy()
   110	    warmup_excluded = int(featured["warmup"].sum())
   111	
   112	    event_frames: list[pd.DataFrame] = []
   113	    for tier, threshold in NEGATIVE_TIERS:
   114	        mask = usable["rolling_pctl"] <= threshold
   115	        readings = usable.loc[mask].copy()
   116	        readings["side"] = "neg"
   117	        readings["tier"] = tier
   118	        event_frames.append(merge_extreme_readings(readings))
   119	
   120	    for tier, threshold in POSITIVE_TIERS:
   121	        mask = usable["rolling_pctl"] >= threshold
   122	        readings = usable.loc[mask].copy()
   123	        readings["side"] = "pos"
   124	        readings["tier"] = tier
   125	        event_frames.append(merge_extreme_readings(readings))
   126	
   127	    events = pd.concat(event_frames, ignore_index=True)
   128	    return events, warmup_excluded
   129	
   130	
   131	def build_events(data_dir: Path = DATA_DIR) -> tuple[pd.DataFrame, dict[str, int]]:
   132	    frames: list[pd.DataFrame] = []
   133	    warmup_by_symbol: dict[str, int] = {}
   134	    for symbol in SYMBOLS:
   135	        path = data_dir / f"{symbol}_FUNDING_8H.csv"
   136	        funding = pd.read_csv(path, parse_dates=["datetime"])
   137	        events, warmup_count = extract_symbol_events(symbol, funding)
   138	        frames.append(events)
   139	        warmup_by_symbol[symbol] = warmup_count
   140	
   141	    all_events = pd.concat(frames, ignore_index=True)
   142	    all_events = all_events.sort_values(
   143	        ["event_time", "symbol", "side", "tier"],
   144	        kind="mergesort",
   145	    ).reset_index(drop=True)
   146	    return all_events.loc[:, OUTPUT_COLUMNS], warmup_by_symbol
   147	
   148	
   149	def split_work_holdout(events: pd.DataFrame) -> tuple[pd.DataFrame, pd.DataFrame]:
   150	    ordinals = pd.Series(range(len(events)), index=events.index)
   151	    holdout_mask = ordinals.mod(5) == 4
   152	    holdout = events.loc[holdout_mask].reset_index(drop=True)
   153	    work = events.loc[~holdout_mask].reset_index(drop=True)
   154	    return work, holdout
   155	
   156	
   157	def tier_counts(events: pd.DataFrame) -> dict[str, int]:
   158	    if events.empty:
   159	        return {}
   160	    counts = (
   161	        events.groupby(["side", "tier"], sort=True)
   162	        .size()
   163	        .rename("events")
   164	        .reset_index()
   165	    )
   166	    return {
   167	        f"{row.side}_{row.tier}": int(row.events)
   168	        for row in counts.itertuples(index=False)
   169	    }
   170	
   171	
   172	def main() -> None:
   173	    OUTPUT_DIR.mkdir(parents=True, exist_ok=True)
   174	    HOLDOUT_DIR.mkdir(parents=True, exist_ok=True)
   175	
