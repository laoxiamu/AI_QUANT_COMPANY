    21	MERGE_WINDOW = pd.Timedelta(hours=24)
    22	
    23	NEGATIVE_TIERS = (("P5", 0.05), ("P2.5", 0.025), ("P1", 0.01))
    24	POSITIVE_TIERS = (("P95", 0.95), ("P97.5", 0.975), ("P99", 0.99))
    25	OUTPUT_COLUMNS = [
    26	    "event_time",
    27	    "symbol",
    28	    "side",
    29	    "tier",
    30	    "funding_value",
