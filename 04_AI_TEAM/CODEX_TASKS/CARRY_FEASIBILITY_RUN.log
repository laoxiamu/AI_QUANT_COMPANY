+PROJECT_ROOT = RESEARCH_ROOT.parent
+DATA = RESEARCH_ROOT / "DATA"
+FUTURES = DATA / "FUTURES"
+OUTPUT = RESEARCH_ROOT / "CODE" / "output"
+CUTOFF = "2024-12-10T00:00:00Z"
+CUTOFF_PREFIX = "2024-12-10"
