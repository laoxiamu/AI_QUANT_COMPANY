+            "post_cutoff_rows": post_cutoff_rows if time_col else None,
+            "time_column": time_col,
+            "min_timestamp_raw": min_ts,
+            "max_timestamp_raw": max_ts,
+            "sha256": sha256_file(path),
+        }
+    )
+    return payload
+
