+
+
+ROOT = Path(__file__).resolve().parents[2]
+DATA = ROOT / "DATA"
+FUTURES = DATA / "FUTURES"
+OUTPUT = ROOT / "CODE" / "output"
+CUTOFF = "2024-12-10T00:00:00Z"
+
+
+FILES = {
+    "BTCUSDT_funding_8h": FUTURES / "BTCUSDT_FUNDING_8H.csv",
