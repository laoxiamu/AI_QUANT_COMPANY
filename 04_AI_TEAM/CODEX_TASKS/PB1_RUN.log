    61	def discover_jsonl_files(inputs: Iterable[str | Path], pattern: str = "*.jsonl") -> list[Path]:
    62	    """Resolve files and recursively scan directories in deterministic order."""
    63	    discovered: set[Path] = set()
    64	    for raw_path in inputs:
    65	        path = Path(raw_path)
    66	        if path.is_file():
    67	            discovered.add(path.resolve())
    68	        elif path.is_dir():
    69	            discovered.update(candidate.resolve() for candidate in path.rglob(pattern) if candidate.is_file())
    70	        else:
    71	            raise FileNotFoundError(f"input path not found: {path}")
    72	    return sorted(discovered)
    73	
    74	
    75	def parse_files(paths: Iterable[Path]) -> tuple[pd.DataFrame, list[ParseReport], int]:
    76	    """Parse files and remove normalized duplicates spanning file boundaries."""
    77	    frames: list[pd.DataFrame] = []
    78	    reports: list[ParseReport] = []
    79	    for path in paths:
    80	        frame, report = parse_jsonl(path)
    81	        frames.append(frame)
    82	        reports.append(report)
    83	
    84	    if not frames:
    85	        return empty_liquidation_frame(), reports, 0
    86	
    87	    combined = pd.concat(frames, ignore_index=True)
    88	    before = len(combined)
    89	    combined = combined.drop_duplicates(subset=OUTPUT_COLUMNS, keep="first")
    90	    cross_file_duplicates = before - len(combined)
    91	    combined = combined.sort_values(["ts_utc", "symbol", "side"], kind="stable").reset_index(drop=True)
    92	    return combined, reports, cross_file_duplicates
    93	
    94	
    95	def _validate_frame(frame: pd.DataFrame) -> pd.DataFrame:
    96	    missing = set(OUTPUT_COLUMNS) - set(frame.columns)
    97	    if missing:
    98	        raise ValueError(f"liquidation frame missing columns: {sorted(missing)}")
    99	
   100	    normalized = frame.loc[:, OUTPUT_COLUMNS].copy()
   101	    normalized["ts_utc"] = pd.to_datetime(normalized["ts_utc"], utc=True, errors="raise")
   102	    normalized["symbol"] = normalized["symbol"].astype("string").str.upper()
   103	    normalized["side"] = normalized["side"].astype("string").str.upper()
   104	    normalized["notional_usdt"] = pd.to_numeric(normalized["notional_usdt"], errors="raise")
   105	    if (~normalized["side"].isin(["SELL", "BUY"])).any():
   106	        raise ValueError("side must be SELL or BUY")
   107	    if (~normalized["notional_usdt"].map(math.isfinite)).any() or (normalized["notional_usdt"] <= 0).any():
   108	        raise ValueError("notional_usdt must be finite and positive")
   109	    return normalized.sort_values(["symbol", "ts_utc"], kind="stable").reset_index(drop=True)
   110	
   111	
   112	def compute_candidate_events(frame: pd.DataFrame, config: CounterConfig) -> tuple[pd.DataFrame, pd.DataFrame]:
   113	    """Compute no-lookahead SELL pulse candidates for target symbols."""
   114	    config.validate()
   115	    normalized = _validate_frame(frame)
   116	    sell = normalized.loc[
   117	        normalized["symbol"].isin(TARGET_SYMBOLS) & normalized["side"].eq("SELL")
   118	    ].copy()
   119	
   120	    signal_columns = [
   121	        *OUTPUT_COLUMNS,
   122	        "rolling_sell_notional",
   123	        "historical_quantile",
   124	        "qualifies",
   125	        "is_candidate",
   126	    ]
   127	    if sell.empty:
   128	        empty = pd.DataFrame(columns=signal_columns)
   129	        return empty, empty.copy()
   130	
   131	    window_delta = pd.Timedelta(config.window)
   132	    symbol_frames: list[pd.DataFrame] = []
   133	    for symbol, group in sell.groupby("symbol", sort=True):
   134	        group = group.sort_values("ts_utc", kind="stable").reset_index(drop=True)
   135	        indexed_notional = group.set_index("ts_utc")["notional_usdt"]
   136	        rolling_sum = indexed_notional.rolling(config.window, closed="right").sum().to_numpy()
   137	        rolling_series = pd.Series(rolling_sum, index=group.index, dtype="float64")
   138	
   139	        # Shift first: the threshold at t is estimated only from rolling sums before t.
   140	        historical_quantile = (
   141	            rolling_series.shift(1)
   142	            .expanding(min_periods=config.min_history)
   143	            .quantile(config.quantile)
   144	        )
   145	        qualifies = historical_quantile.notna() & rolling_series.ge(historical_quantile)
   146	
   147	        if config.count_mode == "all_hits":
   148	            is_candidate = qualifies
   149	        else:
   150	            prior_qualifies = qualifies.shift(1, fill_value=False)
   151	            gap_resets_pulse = group["ts_utc"].diff().ge(window_delta).fillna(True)
   152	            is_candidate = qualifies & (~prior_qualifies | gap_resets_pulse)
   153	
   154	        group["rolling_sell_notional"] = rolling_series
   155	        group["historical_quantile"] = historical_quantile
   156	        group["qualifies"] = qualifies.astype(bool)
   157	        group["is_candidate"] = is_candidate.astype(bool)
   158	        symbol_frames.append(group)
   159	
   160	    signals = pd.concat(symbol_frames, ignore_index=True)
   161	    signals = signals.loc[:, signal_columns].sort_values(["ts_utc", "symbol"], kind="stable")
   162	    signals = signals.reset_index(drop=True)
   163	    events = signals.loc[signals["is_candidate"]].copy().reset_index(drop=True)
   164	    return signals, events
   165	
   166	
   167	def _month_grid(observed: pd.DataFrame) -> pd.DataFrame:
   168	    if observed.empty:
   169	        return pd.DataFrame(columns=["symbol", "month_utc"])
   170	    start = observed["ts_utc"].min().strftime("%Y-%m")
   171	    end = observed["ts_utc"].max().strftime("%Y-%m")
   172	    months = [str(period) for period in pd.period_range(start, end, freq="M")]
   173	    return pd.MultiIndex.from_product(
   174	        [TARGET_SYMBOLS, months],
   175	        names=["symbol", "month_utc"],
   176	    ).to_frame(index=False)
   177	
   178	
   179	def _project_target_date(
   180	    events: pd.DataFrame,
   181	    observed: pd.DataFrame,
   182	    n_min: int,
   183	) -> tuple[float | None, str | None]:
   184	    total = len(events)
   185	    if total >= n_min:
   186	        reached_at = events.sort_values("ts_utc").iloc[n_min - 1]["ts_utc"]
   187	        return None, reached_at.strftime("%Y-%m-%d")
   188	    if total == 0 or observed.empty:
   189	        return None, None
   190	
   191	    start = observed["ts_utc"].min()
   192	    end = observed["ts_utc"].max()
   193	    elapsed_days = (end - start).total_seconds() / 86_400
   194	    if elapsed_days <= 0:
   195	        return None, None
   196	
   197	    rate = total / elapsed_days
   198	    days_needed = math.ceil((n_min - total) / rate)
   199	    projected = end + pd.Timedelta(days=days_needed)
   200	    return rate, projected.strftime("%Y-%m-%d")
   201	
   202	
   203	def summarize_counts(
   204	    frame: pd.DataFrame,
   205	    signals: pd.DataFrame,
   206	    events: pd.DataFrame,
   207	    config: CounterConfig,
   208	) -> CounterResult:
   209	    """Build monthly, symbol, and pooled readiness summaries."""
   210	    observed = _validate_frame(frame)
   211	    observed = observed.loc[observed["symbol"].isin(TARGET_SYMBOLS)].copy()
   212	
   213	    month_grid = _month_grid(observed)
   214	    if events.empty:
   215	        event_monthly = pd.DataFrame(columns=["symbol", "month_utc", "candidate_events"])
   216	    else:
   217	        event_monthly = events.assign(month_utc=events["ts_utc"].dt.strftime("%Y-%m"))
   218	        event_monthly = (
   219	            event_monthly.groupby(["symbol", "month_utc"], as_index=False)
   220	            .size()
   221	            .rename(columns={"size": "candidate_events"})
   222	        )
   223	    monthly = month_grid.merge(event_monthly, on=["symbol", "month_utc"], how="left")
   224	    if not monthly.empty:
   225	        monthly["candidate_events"] = monthly["candidate_events"].fillna(0).astype(int)
   226	        monthly = monthly.sort_values(["month_utc", "symbol"]).reset_index(drop=True)
   227	
   228	    summary_rows: list[dict[str, object]] = []
   229	    for symbol in TARGET_SYMBOLS:
   230	        symbol_events = events.loc[events["symbol"].eq(symbol)].sort_values("ts_utc")
   231	        summary_rows.append(
   232	            {
   233	                "symbol": symbol,
   234	                "cumulative_n": len(symbol_events),
   235	                "first_candidate_utc": (
   236	                    symbol_events["ts_utc"].min().strftime("%Y-%m-%d %H:%M:%S")
   237	                    if not symbol_events.empty
   238	                    else None
   239	                ),
   240	                "last_candidate_utc": (
   241	                    symbol_events["ts_utc"].max().strftime("%Y-%m-%d %H:%M:%S")
   242	                    if not symbol_events.empty
   243	                    else None
   244	                ),
   245	            }
   246	        )
   247	    symbol_summary = pd.DataFrame(summary_rows)
   248	
   249	    event_rate, projected_date = _project_target_date(events, observed, config.n_min)
   250	    overall = {
   251	        "cumulative_n": len(events),
   252	        "n_min": config.n_min,
   253	        "remaining_n": max(config.n_min - len(events), 0),
   254	        "first_candidate_utc": (
   255	            events["ts_utc"].min().strftime("%Y-%m-%d %H:%M:%S") if not events.empty else None
   256	        ),
   257	        "last_candidate_utc": (
   258	            events["ts_utc"].max().strftime("%Y-%m-%d %H:%M:%S") if not events.empty else None
   259	        ),
   260	        "observed_start_utc": (
   261	            observed["ts_utc"].min().strftime("%Y-%m-%d %H:%M:%S") if not observed.empty else None
   262	        ),
   263	        "observed_end_utc": (
   264	            observed["ts_utc"].max().strftime("%Y-%m-%d %H:%M:%S") if not observed.empty else None
   265	        ),
   266	        "event_rate_per_elapsed_day": event_rate,
   267	        "projected_target_date": projected_date,
   268	        "gate_status": "READY" if len(events) >= config.n_min else "NOT_READY",
   269	    }
   270	    return CounterResult(signals, events, monthly, symbol_summary, overall)
   271	
   272	
   273	def run_counter(frame: pd.DataFrame, config: CounterConfig) -> CounterResult:
   274	    signals, events = compute_candidate_events(frame, config)
   275	    return summarize_counts(frame, signals, events, config)
