    22	PROJECT_ROOT = Path(__file__).resolve().parents[3]
    23	DEFAULT_REPORT_PATH = PROJECT_ROOT / "06_RESEARCH/RESULTS/A1_FORWARD_EVENT_COUNT.md"
    24	TARGET_SYMBOLS = ("BTCUSDT", "ETHUSDT", "SOLUSDT")
    25	CountMode = Literal["episode_start", "all_hits"]
