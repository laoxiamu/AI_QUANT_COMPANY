+        symbol="SOLUSDT",
+        side="SELL",
+        qty="1",
+        price="20",
+        average_price="20",
+        trade_ms=1_700_000_120_000,
+    )
+    del missing_qty["o"]["q"]  # type: ignore[index]
+
+    path = tmp_path / "liquidations.jsonl"
+    path.write_text(
+        "\n".join(
+            [
+                json.dumps(sell),
+                "{not-json",
