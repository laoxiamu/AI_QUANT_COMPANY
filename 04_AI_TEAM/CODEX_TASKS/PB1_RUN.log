+    side: str,
+    qty: str,
+    price: str,
+    average_price: str,
+    trade_ms: int,
+) -> dict[str, object]:
+    return {
+        "e": "forceOrder",
+        "E": trade_ms + 1,
+        "o": {
+            "s": symbol,
+            "S": side,
+            "o": "LIMIT",
+            "f": "IOC",
