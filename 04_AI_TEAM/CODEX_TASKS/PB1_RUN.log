   277	
   278	def _display(value: object) -> str:
   279	    if value is None or (isinstance(value, float) and math.isnan(value)):
   280	        return "N/A"
   281	    if isinstance(value, float):
   282	        return f"{value:.6f}"
   283	    return str(value)
   284	
   285	
   286	def _markdown_table(frame: pd.DataFrame) -> str:
   287	    if frame.empty:
   288	        return "_No rows._"
   289	    columns = list(frame.columns)
   290	    header = "| " + " | ".join(columns) + " |"
   291	    separator = "| " + " | ".join("---" for _ in columns) + " |"
   292	    rows = [
   293	        "| " + " | ".join(_display(value) for value in row) + " |"
   294	        for row in frame.itertuples(index=False, name=None)
   295	    ]
   296	    return "\n".join([header, separator, *rows])
   297	
   298	
   299	def render_report(
   300	    result: CounterResult,
   301	    config: CounterConfig,
   302	    input_files: list[Path],
   303	    parse_reports: list[ParseReport],
   304	    cross_file_duplicates: int,
   305	) -> str:
   306	    """Render the readiness monitor; it intentionally contains no returns."""
   307	    generated_at = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
   308	    parser_totals = {
   309	        "files": len(parse_reports),
   310	        "total_lines": sum(report.total_lines for report in parse_reports),
   311	        "parsed_rows": sum(report.parsed_rows for report in parse_reports),
   312	        "bad_lines": sum(report.bad_lines for report in parse_reports),
   313	        "duplicate_lines": sum(report.duplicate_lines for report in parse_reports),
   314	        "cross_file_duplicates": cross_file_duplicates,
   315	    }
   316	    parser_totals["bad_line_ratio"] = (
   317	        parser_totals["bad_lines"] / parser_totals["total_lines"]
   318	        if parser_totals["total_lines"]
   319	        else 0.0
   320	    )
   321	
   322	    overall = result.overall_summary
   323	    real_data_status = "NO INPUT JSONL FOUND" if not input_files else "INPUT JSONL PROCESSED"
   324	    return f"""# A1 Forward Liquidation Event Count
   325	
   326	**Generated UTC:** {generated_at}  
   327	**Data status:** {real_data_status}  
   328	**Readiness gate:** {overall["gate_status"]}
   329	
   330	## Governance
   331	
   332	This is a count-only monitoring artifact. It computes no event-forward returns,
   333	performance metrics, or edge conclusion. All trigger parameters below are
   334	placeholders and must be frozen only by the formal Path B preregistration.
   335	
   336	## Placeholder Parameters
   337	
   338	| parameter | value |
   339	| --- | --- |
   340	| symbols | {", ".join(TARGET_SYMBOLS)} |
   341	| rolling SELL window | {config.window} |
   342	| historical quantile | {config.quantile} |
   343	| minimum prior rolling observations | {config.min_history} |
   344	| count mode | {config.count_mode} |
   345	| readiness target n_min | {config.n_min} |
   346	
   347	The historical quantile at time `t` uses only rolling sums strictly before `t`.
   348	`episode_start` counts the first exceedance in a continuous pulse; a gap of at
   349	least one rolling window resets the pulse.
   350	
   351	## Pooled Readiness
   352	
   353	| metric | value |
   354	| --- | --- |
   355	| cumulative n | {_display(overall["cumulative_n"])} |
   356	| target n_min | {_display(overall["n_min"])} |
   357	| remaining n | {_display(overall["remaining_n"])} |
   358	| first candidate UTC | {_display(overall["first_candidate_utc"])} |
   359	| last candidate UTC | {_display(overall["last_candidate_utc"])} |
   360	| observed start UTC | {_display(overall["observed_start_utc"])} |
   361	| observed end UTC | {_display(overall["observed_end_utc"])} |
   362	| event rate / elapsed day | {_display(overall["event_rate_per_elapsed_day"])} |
   363	| projected target date | {_display(overall["projected_target_date"])} |
   364	
   365	Projection is a linear extrapolation from elapsed calendar coverage and is
   366	unavailable until at least one candidate exists across a positive time span.
   367	It does not adjust for collector downtime or changing market regimes.
   368	
   369	## By Symbol
   370	
   371	{_markdown_table(result.symbol_summary)}
   372	
   373	## By Symbol And UTC Month
   374	
   375	{_markdown_table(result.monthly_counts)}
   376	
   377	## Parser Audit
   378	
   379	```json
   380	{json.dumps(parser_totals, ensure_ascii=False, indent=2)}
   381	```
   382	"""
   383	
   384	
   385	def write_report(
   386	    result: CounterResult,
   387	    config: CounterConfig,
   388	    input_files: list[Path],
   389	    parse_reports: list[ParseReport],
   390	    cross_file_duplicates: int,
   391	    output_path: str | Path = DEFAULT_REPORT_PATH,
   392	) -> Path:
   393	    path = Path(output_path)
   394	    path.parent.mkdir(parents=True, exist_ok=True)
   395	    path.write_text(
   396	        render_report(result, config, input_files, parse_reports, cross_file_duplicates),
   397	        encoding="utf-8",
   398	    )
   399	    return path
   400	
   401	
   402	def parse_args() -> argparse.Namespace:
   403	    parser = argparse.ArgumentParser(description=__doc__)
   404	    parser.add_argument("inputs", nargs="+", type=Path, help="JSONL files or directories.")
   405	    parser.add_argument("--pattern", default="*.jsonl", help="Recursive directory glob.")
   406	    parser.add_argument("--window", default="1h")
   407	    parser.add_argument("--quantile", type=float, default=0.99)
   408	    parser.add_argument("--min-history", type=int, default=24)
   409	    parser.add_argument("--n-min", type=int, default=120)
   410	    parser.add_argument(
   411	        "--count-mode",
   412	        choices=["episode_start", "all_hits"],
   413	        default="episode_start",
   414	    )
   415	    parser.add_argument("--output", type=Path, default=DEFAULT_REPORT_PATH)
   416	    return parser.parse_args()
   417	
   418	
   419	def main() -> int:
   420	    args = parse_args()

