    28	@dataclass(frozen=True)
    29	class CounterConfig:
    30	    """Placeholder readiness-counter parameters, not preregistered values."""
    31	
    32	    window: str = "1h"
    33	    quantile: float = 0.99
    34	    min_history: int = 24
    35	    n_min: int = 120
    36	    count_mode: CountMode = "episode_start"
    37	
    38	    def validate(self) -> None:
    39	        window_delta = pd.Timedelta(self.window)
    40	        if window_delta <= pd.Timedelta(0):
    41	            raise ValueError("window must be positive")
    42	        if not 0.0 <= self.quantile <= 1.0:
    43	            raise ValueError("quantile must be in [0, 1]")
    44	        if self.min_history < 1:
    45	            raise ValueError("min_history must be >= 1")
    46	        if self.n_min < 1:
    47	            raise ValueError("n_min must be >= 1")
    48	        if self.count_mode not in {"episode_start", "all_hits"}:
    49	            raise ValueError(f"unsupported count_mode: {self.count_mode}")
    50	
    51	
    52	@dataclass
    53	class CounterResult:
    54	    signals: pd.DataFrame
    55	    events: pd.DataFrame
    56	    monthly_counts: pd.DataFrame
    57	    symbol_summary: pd.DataFrame
    58	    overall_summary: dict[str, object]
