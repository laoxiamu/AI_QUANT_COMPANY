    17	    from .liq_parser import OUTPUT_COLUMNS, ParseReport, empty_liquidation_frame, parse_jsonl
    18	except ImportError:  # Direct script execution.
    19	    from liq_parser import OUTPUT_COLUMNS, ParseReport, empty_liquidation_frame, parse_jsonl
