+    TASK_INBOX_JSON.write_text(json.dumps(signal, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
+    print(OUTPUT_JSON)
+    print(REPORT_PATH)
+    print(TASK_INBOX_JSON)
+
+
+if __name__ == "__main__":
+    main()

