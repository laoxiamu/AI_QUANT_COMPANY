   495	
   496	def power_diagnostic(
   497	    episodes: pd.DataFrame,
   498	    *,
   499	    horizon: int,
   500	    iccs: Iterable[float] = (0.0, 0.2, 0.5),
   501	) -> list[dict[str, float | int]]:
   502	    """Return the preregistered event-pre variance and clustered MDE diagnostic."""
   503	    car_col = f"car_{horizon}h"
   504	    required = {"event_time", "baseline_variance", car_col}
   505	    missing = required - set(episodes.columns)
   506	    if missing:
   507	        raise ValueError(f"power input missing columns: {sorted(missing)}")
   508	    valid = episodes[car_col].notna() & episodes["baseline_variance"].notna()
   509	    frame = episodes.loc[valid].copy()
   510	    n = len(frame)
   511	    if n == 0:
   512	        return []
   513	    event_days = pd.to_datetime(frame["event_time"], utc=True).dt.date.nunique()
   514	    median_variance = float(frame["baseline_variance"].median())
   515	    sigma_pre = math.sqrt(horizon * median_variance)
   516	    m_bar = n / event_days
   517	    z_sum = NormalDist().inv_cdf(0.95) + NormalDist().inv_cdf(0.80)
   518	    rows: list[dict[str, float | int]] = []
   519	    for icc in iccs:
   520	        n_eff = n / (1.0 + (m_bar - 1.0) * icc)
   521	        rows.append(
   522	            {
   523	                "horizon_hours": horizon,
   524	                "n": n,
   525	                "event_days": int(event_days),
   526	                "m_bar": float(m_bar),
   527	                "icc": float(icc),
   528	                "n_eff": float(n_eff),
   529	                "sigma_pre_h": float(sigma_pre),
   530	                "mde_80": float(z_sum * sigma_pre / math.sqrt(n_eff)),
   531	            }
   532	        )
   533	    return rows

