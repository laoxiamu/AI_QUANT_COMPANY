   434	    )
   435	    lengths = wf_segment_lengths(len(frame))
   436	    boundaries = (lengths[0], lengths[0] + lengths[1])
   437	    if len(frame) < 3 or any(index <= 0 or index >= len(frame) for index in boundaries):
   438	        return {
   439	            "status": "N.A.",
   440	            "lengths_before_purge": list(lengths),
   441	            "cutpoints": [],
   442	            "segments": [],
   443	            "positive_segments": 0,
   444	        }
   445	
   446	    event_times = pd.to_datetime(frame["event_time"], utc=True)
   447	    cutpoints = [
   448	        event_times.iloc[index - 1]
   449	        + (event_times.iloc[index] - event_times.iloc[index - 1]) / 2
   450	        for index in boundaries
   451	    ]
   452	    segment_ids = np.repeat(np.arange(3), lengths)
   453	    frame["segment"] = segment_ids
   454	    frame["footprint_start"] = event_times - pd.Timedelta(hours=72)
   455	    frame["footprint_end"] = pd.to_datetime(frame["align_time"], utc=True) + pd.Timedelta(
   456	        hours=48
   457	    )
   458	    crosses = np.zeros(len(frame), dtype=bool)
   459	    for cutpoint in cutpoints:
   460	        crosses |= (
   461	            (frame["footprint_start"] < cutpoint)
   462	            & (frame["footprint_end"] > cutpoint)
   463	        ).to_numpy()
   464	    frame["purged"] = crosses
   465	
   466	    segment_rows: list[dict[str, object]] = []
   467	    positive = 0
   468	    any_na = False
   469	    for segment in range(3):
   470	        original = frame.loc[frame["segment"] == segment]
   471	        retained = original.loc[~original["purged"]]
   472	        values = pd.to_numeric(retained["car_48h"], errors="coerce").dropna()
   473	        mean = float(values.mean()) if len(values) else None
   474	        if mean is None:
   475	            any_na = True
   476	        elif mean > 0:
   477	            positive += 1
   478	        segment_rows.append(
   479	            {
   480	                "segment": segment + 1,
   481	                "n_before_purge": int(len(original)),
   482	                "n_purged": int(original["purged"].sum()),
   483	                "n_car": int(len(values)),
   484	                "mean_car_48h": mean,
   485	            }
   486	        )
   487	    return {
   488	        "status": "N.A." if any_na else ("PASS" if positive >= 2 else "FAIL"),
   489	        "lengths_before_purge": list(lengths),
   490	        "cutpoints": [item.strftime("%Y-%m-%dT%H:%M:%SZ") for item in cutpoints],
   491	        "segments": segment_rows,
   492	        "positive_segments": positive,
   493	    }
