--- collector source ---
#!/usr/bin/env python3
"""Binance USDT-M liquidation collector - VM direct-connect deployment.

Writes UTC-dated JSONL files under /opt/ai_quant_liq_collector/data/LIQUIDATIONS.
This VM version intentionally does not use any local proxy.
"""
import datetime
import json
import os
import threading
import time

import websocket

WS_URL = "wss://fstream.binance.com/ws/!forceOrder@arr"
BASE_DIR = "/opt/ai_quant_liq_collector"
OUT_DIR = os.path.join(BASE_DIR, "data", "LIQUIDATIONS")
os.makedirs(OUT_DIR, exist_ok=True)

_last_message_ms = None
_message_count = 0


def utc_now():
    return datetime.datetime.now(datetime.timezone.utc)


def path_for_today():
    return os.path.join(OUT_DIR, "liq_%s.jsonl" % utc_now().strftime("%Y%m%d"))


def line_count(path):
    if not os.path.exists(path):
        return 0
    with open(path, "r", encoding="utf-8") as f:
        return sum(1 for _ in f)


def on_open(ws):
    print("[connected]", utc_now().isoformat(), WS_URL, flush=True)


def on_message(ws, message):
    global _last_message_ms, _message_count
    try:
        data = json.loads(message)
        data["recv_ts"] = int(time.time() * 1000)
        with open(path_for_today(), "a", encoding="utf-8") as f:
            f.write(json.dumps(data, separators=(",", ":"), ensure_ascii=False) + "\n")
        _last_message_ms = data["recv_ts"]
        _message_count += 1
        if _message_count <= 3 or _message_count % 100 == 0:
            print("[message]", utc_now().isoformat(), "count=", _message_count, flush=True)
    except Exception as exc:
        print("write error:", repr(exc), flush=True)


def on_error(ws, err):
    print("ws error:", repr(err), flush=True)


def on_close(ws, code, msg):
    print("ws closed:", code, msg, flush=True)


def heartbeat_log():
    while True:
        time.sleep(3600)
        p = path_for_today()
        last = None
        if _last_message_ms is not None:
            last = datetime.datetime.fromtimestamp(_last_message_ms / 1000, tz=datetime.timezone.utc).isoformat()
        print(
            "[heartbeat]",
            utc_now().isoformat(),
            "today_rows=", line_count(p),
            "process_messages=", _message_count,
            "last_message_utc=", last,
            flush=True,
        )


def main():
    threading.Thread(target=heartbeat_log, daemon=True).start()
    print("starting liquidation collector (VM direct, no proxy)", flush=True)
    while True:
        try:
            ws = websocket.WebSocketApp(
                WS_URL,
                on_open=on_open,
                on_message=on_message,
                on_error=on_error,
                on_close=on_close,
            )
            ws.run_forever(ping_interval=180, ping_timeout=10)
        except Exception as exc:
            print("reconnect after error:", repr(exc), flush=True)
        time.sleep(5)


if __name__ == "__main__":
    main()
