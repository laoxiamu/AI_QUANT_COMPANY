+    holm_adjust,
+    trigger_mask,
+)
+
+
+def test_trigger_requires_p1_and_negative_mark_return() -> None:
+    features = pd.DataFrame(
+        {
+            "d6h_rolling_pctl": [0.01, 0.0101, 0.005, 0.001],
+            "r6h_mark": [-0.01, -0.01, 0.0, 0.02],
+        }
+    )
+    assert trigger_mask(features).tolist() == [True, False, False, False]
+
+
+def test_refractory_allows_trigger_at_exactly_24_hours() -> None:
+    triggers = pd.DataFrame(
+        {
+            "event_time_utc": pd.to_datetime(
+                [
+                    "2024-01-01T00:00:00Z",
+                    "2024-01-01T23:00:00Z",
+                    "2024-01-02T00:00:00Z",
+                    "2024-01-02T01:00:00Z",
+                ],
+                utc=True,
+            ),
+            "value": [1, 2, 3, 4],
+        }
+    )
+    kept = apply_refractory(triggers)
+    assert kept["value"].tolist() == [1, 3]
+
+
+def test_moving_block_wrap_order_controls_last_block_truncation() -> None:
+    times = pd.to_datetime(
+        [
+            "2024-01-01T00:00:00Z",
+            "2024-01-01T01:00:00Z",
+            "2024-01-01T08:00:00Z",
+            "2024-01-01T09:00:00Z",
+        ],
+        utc=True,
+    )
+    sampler = CircularBlockSampler(times, block_hours=4)
+    sampled = sampler.sample_indices(
+        np.random.default_rng(1),
+        sample_size=2,
+        start_offsets=iter([8]),
+    )
+    assert sampled.tolist() == [2, 3]
+    wrapped = sampler.sample_indices(
+        np.random.default_rng(1),
+        sample_size=4,
+        start_offsets=iter([8]),
+    )
+    assert wrapped.tolist() == [2, 3, 0, 1]
+
+
+def test_holm_uses_fixed_family_size_including_missing_item() -> None:
+    result = holm_adjust(
+        {"car_48h": 0.01, "car_24h": 0.02, "mono": 0.04, "non_overlap": None}
+    )
+    assert result["car_48h"]["p_holm"] == 0.04
+    assert result["car_24h"]["p_holm"] == 0.06
+    assert result["mono"]["p_holm"] == 0.08
+    assert result["non_overlap"]["p_holm"] is None
+
+
+def test_aes_256_gcm_round_trip_and_authentication() -> None:
+    key = bytes(range(32))
+    nonce = bytes(range(12))
+    plaintext = b"sealed episode fixture\n"
+    encrypted = encrypt_aes_gcm(plaintext, key, nonce)
+    assert encrypted[:12] == nonce
+    assert decrypt_aes_gcm(encrypted, key) == plaintext
+
+    tampered = bytearray(encrypted)
+    tampered[-1] ^= 1
+    try:
+        decrypt_aes_gcm(bytes(tampered), key)
+    except Exception:
+        pass
+    else:
+        raise AssertionError("tampered GCM tag was accepted")
+
+
+def test_rolling_midrank_enforces_days_samples_and_prior_only() -> None:
+    times = pd.date_range("2023-01-01", periods=24 * 180 + 1, freq="h", tz="UTC")
+    values = np.zeros(len(times))
+    values[-1] = 1.0
+    frame = pd.DataFrame({"ts": times, "d6h_pct": values})
+    result = add_rolling_midrank(
+        frame,
+        time_col="ts",
+        value_col="d6h_pct",
+    )
+    target = result.iloc[-1]
+    assert target["window_distinct_days"] == 180
+    assert target["window_valid_samples"] == 24 * 180
+    assert target["rolling_pctl"] == 1.0

