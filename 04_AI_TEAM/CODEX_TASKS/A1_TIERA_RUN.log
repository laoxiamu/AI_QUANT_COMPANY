+            if timestamp >= CUTOFF_EXCLUSIVE:
+                break
+            rows.append(
+                {
+                    "ts": timestamp,
+                    "value": pd.to_numeric(row[value_column], errors="coerce"),
+                }
+            )
+    return pd.DataFrame(rows)
 
