+#!/usr/bin/env python3
+"""Custodian-only A-1 episode generation and authenticated sealing."""
+
+from __future__ import annotations
+
+import argparse
+import gc
+import json
+import math
+import os
+import subprocess
+from pathlib import Path
+
+import numpy as np
+import pandas as pd
+
+from a1_tiera_common import (
