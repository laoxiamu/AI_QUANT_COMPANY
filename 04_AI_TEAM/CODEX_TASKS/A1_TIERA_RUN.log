+) -> pd.DataFrame:
+    """Read an ascending CSV only until the exclusive preregistered cutoff."""
+    rows: list[dict[str, object]] = []
+    with path.open("r", newline="", encoding="utf-8") as handle:
+        reader = csv.DictReader(handle)
