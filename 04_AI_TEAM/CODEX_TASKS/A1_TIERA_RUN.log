+def _test_cells(
+    payload: dict[str, Any] | None,
+    adjusted_p: float | None,
+) -> tuple[str, str, str, str]:
+    if payload is None:
+        return "N.A.", "N.A.", "N.A.", "N.A."
+    return (
+        _pct(payload["estimate"]),
+        _num(payload["raw_p"]),
+        _num(adjusted_p),
+        f"[{_pct(payload['ci_low'])}, {_pct(payload['ci_high'])}]",
+    )
 
 
