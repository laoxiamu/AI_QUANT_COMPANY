@@ -0,0 +1,644 @@
+#!/usr/bin/env python3
+"""Work-only executor for the preregistered A-1 Tier A screen."""
+
+from __future__ import annotations
+
+import argparse
+import json
+import math
+import subprocess
+import sys
+from pathlib import Path
+from statistics import NormalDist
+
+import numpy as np
+import pandas as pd
+
+from a1_tiera_common import (
+    BOOTSTRAP_REPS,
+    CUTOFF,
+    DATA_DIR,
+    DEFAULT_KEY_PATH,
+    HORIZONS,
+    MANIFEST_PATH,
+    OUTPUT_DIR,
+    PERMTEST_PATH,
+    RESULTS_DIR,
+    ROOT,
+    SEALED_PATH,
+    SEED,
+    SYMBOLS,
+    WORK_EPISODES_PATH,
+    assert_not_restricted_path,
+    decrypt_aes_gcm,
+    holm_adjust,
+    moving_block_mean_test,
+    moving_block_spearman_test,
+    parse_utc,
+    read_csv_before_cutoff,
+    sha256_bytes,
+    utc_text,
+)
+
+
+REPORT_PATH = RESULTS_DIR / "20260615_a1_tierA_screen.md"
+METRICS_PATH = OUTPUT_DIR / "a1_tiera_work_metrics.csv"
+SUMMARY_PATH = OUTPUT_DIR / "a1_tiera_summary.json"
+
+
+def attempt_decrypt_for_negative_test() -> int:
+    """Return nonzero only when the key is inaccessible or authentication fails."""
+    try:
+        key = DEFAULT_KEY_PATH.read_bytes()
+    except (FileNotFoundError, PermissionError, OSError) as exc:
+        print(f"KEY_ACCESS_FAILED: {type(exc).__name__}: {exc}", file=sys.stderr)
+        return 13
+    try:
+        decrypt_aes_gcm(SEALED_PATH.read_bytes(), key)
+    except Exception as exc:
+        print(f"GCM_AUTH_FAILED: {type(exc).__name__}: {exc}", file=sys.stderr)
+        return 14
+    print("SECURITY_FAILURE: sealed plaintext decrypted under executor identity", file=sys.stderr)
+    return 0
+
+
+def run_permission_test() -> bool:
+    lines: list[str] = []
+    manifest_command = (
+        f"{sys.executable} -c \"from pathlib import Path; "
+        f"Path('{MANIFEST_PATH}').read_bytes()\""
+    )
+    try:
+        MANIFEST_PATH.read_bytes()
+        manifest_exit = 0
+        manifest_reason = "manifest readable"
+    except Exception as exc:
+        manifest_exit = 1
+        manifest_reason = f"{type(exc).__name__}: {exc}"
+    lines.extend(
+        [
+            f"manifest_command={manifest_command}",
+            f"manifest_exit_code={manifest_exit}",
+            f"manifest_result={manifest_reason}",
+        ]
+    )
+
+    decrypt_command = [sys.executable, str(Path(__file__).resolve()), "--attempt-decrypt"]
+    completed = subprocess.run(decrypt_command, capture_output=True, text=True)
+    reason = (completed.stderr or completed.stdout).strip().replace("\n", " | ")
+    negative_pass = completed.returncode in (13, 14)
+    overall = manifest_exit == 0 and negative_pass
+    lines.extend(
+        [
+            f"decrypt_command={' '.join(decrypt_command)}",
+            f"decrypt_exit_code={completed.returncode}",
+            f"decrypt_result={reason}",
+            f"overall={'PASS' if overall else 'FAIL'}",
+        ]
+    )
+    PERMTEST_PATH.write_text("\n".join(lines) + "\n", encoding="utf-8")
+    return overall
+
+
+def require_permission_boundary() -> None:
+    if not PERMTEST_PATH.exists():
+        raise RuntimeError("permission test log is missing")
+    content = PERMTEST_PATH.read_text(encoding="utf-8")
+    if "overall=PASS" not in content:
+        raise RuntimeError("permission boundary test did not pass")
+
+
+def load_work_episodes() -> pd.DataFrame:
+    if WORK_EPISODES_PATH.resolve() != (ROOT / "06_RESEARCH/DATA/A1_WORK/work_episodes.csv").resolve():
+        raise AssertionError("executor episode path is not the frozen work path")
+    assert_not_restricted_path(WORK_EPISODES_PATH)
+    episodes = pd.read_csv(WORK_EPISODES_PATH)
+    required = {
+        "event_time_utc",
+        "symbol",
+        "d6h_rolling_pctl",
+        "severity",
+        "severity_code",
+        "a2_overlap",
+        "regime",
+    }
+    missing = required.difference(episodes.columns)
+    if missing:
+        raise ValueError(f"work episodes missing columns: {sorted(missing)}")
+    episodes["event_time"] = pd.to_datetime(episodes["event_time_utc"], utc=True)
+    episodes["a2_overlap"] = pd.to_numeric(episodes["a2_overlap"], errors="coerce")
+    return episodes.sort_values(
+        ["event_time", "symbol"], kind="mergesort"
+    ).reset_index(drop=True)
+
+
+def load_mark_closes(symbol: str) -> pd.Series:
+    path = DATA_DIR / f"{symbol}_MARK_1H.csv"
+    frame = read_csv_before_cutoff(
+        path, time_col="datetime", usecols=["datetime", "close"]
+    )
+    frame["close"] = pd.to_numeric(frame["close"], errors="coerce")
+    frame["close_time"] = pd.to_datetime(frame["datetime"], utc=True) + pd.Timedelta(hours=1)
+    if frame["close_time"].duplicated().any():
+        raise ValueError(f"{path.name} has duplicate close timestamps")
+    return frame.set_index("close_time")["close"].sort_index()
+
+
+def load_funding(symbol: str) -> pd.Series:
+    path = DATA_DIR / f"{symbol}_FUNDING_8H.csv"
+    frame = read_csv_before_cutoff(
+        path,
+        time_col="datetime",
+        usecols=["datetime", "last_funding_rate"],
+    )
+    frame["last_funding_rate"] = pd.to_numeric(
+        frame["last_funding_rate"], errors="coerce"
+    )
+    return frame.set_index("datetime")["last_funding_rate"].sort_index()
+
+
+def exact_hourly_returns(
+    closes: pd.Series,
+    end_times: pd.DatetimeIndex,
+) -> np.ndarray | None:
+    current = closes.reindex(end_times)
+    prior = closes.reindex(end_times - pd.Timedelta(hours=1))
+    if current.isna().any() or prior.isna().any():
+        return None
+    return np.log(current.to_numpy(dtype=float) / prior.to_numpy(dtype=float))
+
+
+def compute_work_metrics(
+    episodes: pd.DataFrame,
+    closes_by_symbol: dict[str, pd.Series],
+    funding_by_symbol: dict[str, pd.Series],
+) -> pd.DataFrame:
+    rows: list[dict[str, object]] = []
+    for episode in episodes.itertuples(index=False):
+        row = episode._asdict()
+        event_time = parse_utc(row["event_time"])
+        closes = closes_by_symbol[row["symbol"]]
+        close_times = closes.index
+        signal_available = event_time + pd.Timedelta(hours=1)
+        align_pos = int(close_times.searchsorted(signal_available, side="right"))
+        align = close_times[align_pos] if align_pos < len(close_times) else pd.NaT
+        row["signal_available_time"] = signal_available
+        row["align_time"] = align
+
+        baseline_ends = pd.date_range(
+            event_time - pd.Timedelta(hours=72),
+            event_time - pd.Timedelta(hours=1),
+            freq="h",
+            tz="UTC",
+        )
+        baseline = exact_hourly_returns(closes, baseline_ends)
+        if baseline is None:
+            row["baseline_n"] = 0
+            row["baseline_mu"] = math.nan
+            row["baseline_var"] = math.nan
+        else:
+            row["baseline_n"] = int(len(baseline))
+            row["baseline_mu"] = float(np.mean(baseline))
+            row["baseline_var"] = float(np.var(baseline, ddof=1))
+
+        for horizon in HORIZONS:
+            target = align + pd.Timedelta(hours=horizon) if pd.notna(align) else pd.NaT
+            if (
+                pd.isna(align)
+                or target not in closes.index
+                or not np.isfinite(row["baseline_mu"])
+            ):
+                row[f"raw_{horizon}h"] = math.nan
+                row[f"car_{horizon}h"] = math.nan
+                continue
+            raw_return = math.log(float(closes.loc[target]) / float(closes.loc[align]))
+            row[f"raw_{horizon}h"] = raw_return
+            row[f"car_{horizon}h"] = raw_return - horizon * float(row["baseline_mu"])
+
+        if pd.notna(align):
+            end_48h = align + pd.Timedelta(hours=48)
+            funding = funding_by_symbol[row["symbol"]]
+            held = funding.loc[(funding.index > align) & (funding.index <= end_48h)]
+            row["holding_funding_48h"] = float(held.sum())
+            row["funding_readings_48h"] = int(len(held))
+        else:
+            row["holding_funding_48h"] = math.nan
+            row["funding_readings_48h"] = 0
+        rows.append(row)
+    return pd.DataFrame(rows)
+
+
+def valid_test_frame(metrics: pd.DataFrame, value_col: str) -> pd.DataFrame:
+    return metrics.loc[
+        metrics[value_col].notna(), ["event_time", value_col]
+    ].sort_values("event_time")
+
+
+def mean_test(metrics: pd.DataFrame, value_col: str) -> dict[str, object]:
+    valid = valid_test_frame(metrics, value_col)
+    return moving_block_mean_test(
+        valid["event_time"].tolist(),
+        valid[value_col].astype(float).tolist(),
+        seed=SEED,
+        reps=BOOTSTRAP_REPS,
+    )
+
+
+def power_diagnostic(metrics: pd.DataFrame, horizon: int) -> dict[str, object]:
+    valid = metrics.loc[
+        metrics[f"car_{horizon}h"].notna() & metrics["baseline_var"].notna()
+    ].copy()
+    n = len(valid)
+    if n == 0:
+        return {"status": "N.A.", "n": 0}
+    days = valid["event_time"].dt.floor("D").nunique()
+    m_bar = n / days
+    sigma_pre = math.sqrt(horizon * float(valid["baseline_var"].median()))
+    z_sum = NormalDist().inv_cdf(0.95) + NormalDist().inv_cdf(0.80)
+    scenarios: dict[str, object] = {}
+    for icc in (0.0, 0.2, 0.5):
+        n_eff = n / (1 + (m_bar - 1) * icc)
+        scenarios[str(icc)] = {
+            "n_eff": n_eff,
+            "mde_80pct": z_sum * sigma_pre / math.sqrt(n_eff),
+        }
+    return {
+        "status": "OK",
+        "n": int(n),
+        "episode_days": int(days),
+        "m_bar": m_bar,
+        "sigma_pre_h": sigma_pre,
+        "icc": scenarios,
+    }
+
+
+def walk_forward(metrics: pd.DataFrame) -> dict[str, object]:
+    ordered = metrics.sort_values(
+        ["event_time", "symbol"], kind="mergesort"
+    ).reset_index(drop=True)
+    n = len(ordered)
+    if n < 3:
+        return {"status": "N.A.", "reason": "fewer than three work episodes"}
+    first = math.ceil(n / 3)
+    second = math.ceil((n - first) / 2)
+    lengths = [first, second, n - first - second]
+    boundaries = [first, first + second]
+    cutpoints = [
+        ordered.loc[position - 1, "event_time"]
+        + (ordered.loc[position, "event_time"] - ordered.loc[position - 1, "event_time"]) / 2
+        for position in boundaries
+    ]
+    ordered["segment"] = np.repeat([1, 2, 3], lengths)
+    ordered["footprint_start"] = ordered["event_time"] - pd.Timedelta(hours=72)
+    ordered["footprint_end"] = ordered["align_time"] + pd.Timedelta(hours=48)
+    ordered["purged"] = False
+    for cutpoint in cutpoints:
+        crosses = (
+            (ordered["footprint_start"] <= cutpoint)
+            & (ordered["footprint_end"] >= cutpoint)
+        )
+        ordered.loc[crosses, "purged"] = True
+
+    segments: list[dict[str, object]] = []
+    positive = 0
+    for segment in (1, 2, 3):
+        pool = ordered.loc[
+            (ordered["segment"] == segment)
+            & ~ordered["purged"]
+            & ordered["car_48h"].notna()
+        ]
+        mean = float(pool["car_48h"].mean()) if len(pool) else None
+        if mean is not None and mean > 0:
+            positive += 1
+        segments.append(
+            {
+                "segment": segment,
+                "original_n": int((ordered["segment"] == segment).sum()),
+                "purged_n": int(
+                    ((ordered["segment"] == segment) & ordered["purged"]).sum()
+                ),
+                "effective_n": int(len(pool)),
+                "mean_car_48h": mean,
+            }
+        )
+    status = "PASS" if positive >= 2 and all(item["effective_n"] > 0 for item in segments) else "FAIL"
+    return {
+        "status": status,
+        "segment_lengths": lengths,
+        "cutpoints_utc": [utc_text(value) for value in cutpoints],
+        "positive_segments": int(positive),
+        "segments": segments,
+    }
+
+
+def cost_diagnostic(metrics: pd.DataFrame) -> dict[str, object]:
+    valid = metrics.loc[
+        metrics["car_48h"].notna() & metrics["holding_funding_48h"].notna()
+    ].copy()
+    if valid.empty:
+        return {"status": "N.A."}
+    valid["net_base"] = valid["car_48h"] - 0.004 - valid["holding_funding_48h"]
+    valid["net_slip_030"] = valid["car_48h"] - 0.008 - valid["holding_funding_48h"]
+    return {
+        "status": "OK",
+        "n": int(len(valid)),
+        "mean_gross_car_48h": float(valid["car_48h"].mean()),
+        "mean_holding_funding": float(valid["holding_funding_48h"].mean()),
+        "mean_net_base": float(valid["net_base"].mean()),
+        "mean_net_slippage_0.30pct_per_side": float(valid["net_slip_030"].mean()),
+    }
+
+
+def regime_diagnostic(metrics: pd.DataFrame) -> list[dict[str, object]]:
+    rows: list[dict[str, object]] = []
+    for (symbol, regime), group in metrics.groupby(["symbol", "regime"], dropna=False):
+        valid = group["car_48h"].dropna()
+        rows.append(
+            {
+                "symbol": symbol,
+                "regime": regime,
+                "n": int(len(valid)),
+                "mean_car_48h": float(valid.mean()) if len(valid) else None,
+            }
+        )
+    return rows
+
+
+def run_study() -> tuple[pd.DataFrame, dict[str, object]]:
+    require_permission_boundary()
+    episodes = load_work_episodes()
+    closes = {symbol: load_mark_closes(symbol) for symbol in SYMBOLS}
+    funding = {symbol: load_funding(symbol) for symbol in SYMBOLS}
+    metrics = compute_work_metrics(episodes, closes, funding)
+
+    tests = {
+        "car_48h": mean_test(metrics, "car_48h"),
+        "car_24h": mean_test(metrics, "car_24h"),
+        "car_72h_exploratory": mean_test(metrics, "car_72h"),
+    }
+    mono_pool = metrics.loc[
+        metrics["car_48h"].notna() & metrics["severity_code"].notna()
+    ].sort_values("event_time")
+    tests["monotonicity"] = moving_block_spearman_test(
+        mono_pool["event_time"].tolist(),
+        mono_pool["severity_code"].astype(float).tolist(),
+        mono_pool["car_48h"].astype(float).tolist(),
+        seed=SEED,
+        reps=BOOTSTRAP_REPS,
+    )
+
+    overlap = metrics.loc[metrics["a2_overlap"] == 1].copy()
+    non_overlap = metrics.loc[metrics["a2_overlap"] == 0].copy()
+    tests["overlap_48h"] = mean_test(overlap, "car_48h")
+    tests["non_overlap_48h"] = mean_test(non_overlap, "car_48h")
+
+    family_p = {
+        "car_48h": tests["car_48h"].get("p_raw"),
+        "car_24h": tests["car_24h"].get("p_raw"),
+        "monotonicity": tests["monotonicity"].get("p_raw"),
+        "non_overlap_48h": tests["non_overlap_48h"].get("p_raw"),
+    }
+    holm = holm_adjust(family_p)
+    for name, adjustment in holm.items():
+        tests[name]["holm"] = adjustment
+
+    wf = walk_forward(metrics)
+    discipline_pass = "overall=PASS" in PERMTEST_PATH.read_text(encoding="utf-8")
+    gates = {
+        "car_48h": bool(
+            tests["car_48h"].get("mean", -math.inf) > 0
+            and holm["car_48h"]["significant"] is True
+        ),
+        "monotonicity": bool(
+            tests["monotonicity"].get("rho", -math.inf) > 0
+            and holm["monotonicity"]["significant"] is True
+        ),
+        "non_overlap_48h": bool(
+            tests["non_overlap_48h"].get("mean", -math.inf) > 0
+            and holm["non_overlap_48h"]["significant"] is True
+        ),
+        "walk_forward": wf["status"] == "PASS",
+        "discipline": discipline_pass,
+    }
+    verdict = "PASS" if all(gates.values()) else "FAILED"
+    manifest_bytes = MANIFEST_PATH.read_bytes()
+    summary = {
+        "generated_at_utc": utc_text(pd.Timestamp.now(tz="UTC")),
+        "seed": SEED,
+        "bootstrap_reps": BOOTSTRAP_REPS,
+        "cutoff_exclusive_utc": utc_text(CUTOFF),
+        "work_rows": int(len(episodes)),
+        "manifest_sha256": sha256_bytes(manifest_bytes),
+        "tests": tests,
+        "holm_family_m4": holm,
+        "p_overlap": float((metrics["a2_overlap"] == 1).mean()),
+        "overlap_rows": int((metrics["a2_overlap"] == 1).sum()),
+        "non_overlap_rows": int((metrics["a2_overlap"] == 0).sum()),
+        "power": {str(h): power_diagnostic(metrics, h) for h in HORIZONS},
+        "non_overlap_power_48h": power_diagnostic(non_overlap, 48),
+        "walk_forward": wf,
+        "cost": cost_diagnostic(metrics),
+        "regime": regime_diagnostic(metrics),
+        "gates": gates,
+        "verdict": verdict,
+    }
+    return metrics, summary
+
+
+def pct(value: object) -> str:
+    if value is None or not np.isfinite(float(value)):
+        return "N.A."
+    return f"{100 * float(value):.4f}%"
+
+
+def num(value: object, digits: int = 6) -> str:
+    if value is None or not np.isfinite(float(value)):
+        return "N.A."
+    return f"{float(value):.{digits}f}"
+
+
+def render_report(summary: dict[str, object], manifest: dict[str, object]) -> str:
+    tests = summary["tests"]
+    holm = summary["holm_family_m4"]
+    gates = summary["gates"]
+    verdict = summary["verdict"]
+    if verdict == "PASS":
+        top = "Tier A PASS（可观测条件回弹关联成立，探索级，不声称机制）"
+        cto = "对 CTO 的提示：本结果支持继续投路径B前向确证。"
+    else:
+        top = "Tier A FAILED"
+        cto = "对 CTO 的提示：本结果不支持继续投路径B前向确证。"
+
+    def ci(test: dict[str, object]) -> str:
+        values = test.get("ci95_basic")
+        return (
+            f"[{pct(values[0])}, {pct(values[1])}]"
+            if values is not None
+            else "N.A."
+        )
+
+    rows = [
+        (
+            "48h CAR",
+            "PASS" if gates["car_48h"] else "FAIL",
+            "yes",
+            tests["car_48h"],
+            holm["car_48h"],
+        ),
+        (
+            "24h CAR",
+            "PASS" if holm["car_24h"]["significant"] else "FAIL",
+            "no (family member)",
+            tests["car_24h"],
+            holm["car_24h"],
+        ),
+        (
+            "Severity monotonicity",
+            "PASS" if gates["monotonicity"] else "FAIL",
+            "yes",
+            tests["monotonicity"],
+            holm["monotonicity"],
+        ),
+        (
+            "A-2 non-overlap 48h",
+            "PASS" if gates["non_overlap_48h"] else "FAIL",
+            "yes",
+            tests["non_overlap_48h"],
+            holm["non_overlap_48h"],
+        ),
+    ]
+    decision_lines = [
+        "| Item | Status | Gating | Estimate | Raw p | Holm p | 95% basic CI | n |",
+        "|---|---|---:|---:|---:|---:|---|---:|",
+    ]
+    for label, status, gating, test, adjustment in rows:
+        estimate = test.get("rho") if label == "Severity monotonicity" else test.get("mean")
+        estimate_text = num(estimate) if label == "Severity monotonicity" else pct(estimate)
+        decision_lines.append(
+            f"| {label} | {status} | {gating} | {estimate_text} | "
+            f"{num(adjustment['p_raw'])} | {num(adjustment['p_holm'])} | "
+            f"{'N.A.' if label == 'Severity monotonicity' else ci(test)} | {test.get('n', 'N.A.')} |"
+        )
+    wf = summary["walk_forward"]
+    decision_lines.extend(
+        [
+            f"| WF stability | {wf['status']} | yes | {wf.get('positive_segments', 'N.A.')} positive segments | N.A. | N.A. | N.A. | {summary['work_rows']} |",
+            f"| Holdout/rule discipline | {'PASS' if gates['discipline'] else 'FAIL'} | yes | permission test | N.A. | N.A. | N.A. | N.A. |",
+        ]
+    )
+
+    power_lines = [
+        "| Horizon | n | sigma_pre_h | n_eff ICC=0 | n_eff ICC=0.2 | n_eff ICC=0.5 | MDE ICC=0.5 |",
+        "|---:|---:|---:|---:|---:|---:|---:|",
+    ]
+    for horizon in HORIZONS:
+        payload = summary["power"][str(horizon)]
+        if payload["status"] != "OK":
+            power_lines.append(f"| {horizon}h | 0 | N.A. | N.A. | N.A. | N.A. | N.A. |")
+            continue
+        power_lines.append(
+            f"| {horizon}h | {payload['n']} | {pct(payload['sigma_pre_h'])} | "
+            f"{num(payload['icc']['0.0']['n_eff'], 2)} | "
+            f"{num(payload['icc']['0.2']['n_eff'], 2)} | "
+            f"{num(payload['icc']['0.5']['n_eff'], 2)} | "
+            f"{pct(payload['icc']['0.5']['mde_80pct'])} |"
+        )
+
+    wf_lines = [
+        "| Segment | Original n | Purged n | Effective n | Mean 48h CAR |",
+        "|---:|---:|---:|---:|---:|",
+    ]
+    for segment in wf.get("segments", []):
+        wf_lines.append(
+            f"| {segment['segment']} | {segment['original_n']} | {segment['purged_n']} | "
+            f"{segment['effective_n']} | {pct(segment['mean_car_48h'])} |"
+        )
+
+    cost = summary["cost"]
+    return "\n".join(
+        [
+            top,
+            "",
+            "# A-1 Tier A Historical Association Screen",
+            "",
+            "## Decision Table",
+            "",
+            *decision_lines,
+            "",
+            f"Final verdict: **{verdict}**.",
+            "",
+            "## Sample And Sealing",
+            "",
+            f"- Work rows: `{summary['work_rows']}`",
+            f"- Sealed rows: `{manifest['sealed_rows']}`",
+            f"- Manifest SHA-256: `{summary['manifest_sha256']}`",
+            f"- Work SHA-256: `{manifest['work_plaintext_sha256']}`",
+            f"- Sealed ciphertext SHA-256: `{manifest['sealed_ciphertext_sha256']}`",
+            "- Negative permission test: PASS (manifest readable; decrypt attempt failed without an accessible key).",
+            "- Existing A-1 feature outputs were not reused because they use contract-count OI; this run rebuilt nominal OI from `sum_open_interest_value`.",
+            "",
+            "## Horizon And Power Diagnostics",
+            "",
+            *power_lines,
+            "",
+            f"- 72h exploratory mean CAR: {pct(tests['car_72h_exploratory'].get('mean'))}; raw p={num(tests['car_72h_exploratory'].get('p_raw'))}; n={tests['car_72h_exploratory'].get('n', 'N.A.')}.",
+            f"- A-2 overlap share: {pct(summary['p_overlap'])}; overlap n={summary['overlap_rows']}; non-overlap n={summary['non_overlap_rows']}.",
+            "",
+            "## Walk-Forward",
+            "",
+            *wf_lines,
+            "",
+            f"- Cutpoints: `{', '.join(wf.get('cutpoints_utc', []))}`",
+            f"- Result: `{wf['status']}`",
+            "",
+            "## Cost Diagnostic",
+            "",
+            f"- 48h mean gross CAR: {pct(cost.get('mean_gross_car_48h'))}",
+            f"- Mean realized holding funding: {pct(cost.get('mean_holding_funding'))}",
+            f"- Mean net CAR, base slippage 0.10%/side: {pct(cost.get('mean_net_base'))}",
+            f"- Mean net CAR, stress slippage 0.30%/side: {pct(cost.get('mean_net_slippage_0.30pct_per_side'))}",
+            "",
+            "## Frozen Execution Audit",
+            "",
+            f"- Bootstrap: circular moving block, W=144h, B={BOOTSTRAP_REPS}, seed={SEED}.",
+            "- Holm family m=4: 48h, 24h, monotonicity, non-overlap 48h.",
+            "- Event CAR calculations loaded only `work_episodes.csv`; no sealed plaintext or pre-existing holdout event file was loaded.",
+            "- Cutoff was enforced by streaming each sorted market CSV only until `2024-12-10T00:00:00Z`.",
+            "",
+            cto,
+            "",
+        ]
+    )
+
+
+def execute_and_write() -> dict[str, object]:
+    metrics, summary = run_study()
+    manifest = json.loads(MANIFEST_PATH.read_text(encoding="utf-8"))
+    OUTPUT_DIR.mkdir(parents=True, exist_ok=True)
+    RESULTS_DIR.mkdir(parents=True, exist_ok=True)
+    metrics.to_csv(METRICS_PATH, index=False)
+    SUMMARY_PATH.write_text(
+        json.dumps(summary, ensure_ascii=False, indent=2) + "\n",
+        encoding="utf-8",
+    )
+    REPORT_PATH.write_text(render_report(summary, manifest), encoding="utf-8")
+    return summary
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    modes = parser.add_mutually_exclusive_group(required=True)
+    modes.add_argument("--attempt-decrypt", action="store_true")
+    modes.add_argument("--permtest", action="store_true")
+    modes.add_argument("--execute", action="store_true")
+    args = parser.parse_args()
+    if args.attempt_decrypt:
+        raise SystemExit(attempt_decrypt_for_negative_test())
+    if args.permtest:
+        raise SystemExit(0 if run_permission_test() else 1)
+    summary = execute_and_write()
+    print(json.dumps(summary, ensure_ascii=False, indent=2))
+
+
+if __name__ == "__main__":
+    main()
