+]
+
+
+def load_mark_buckets(symbol: str) -> pd.DataFrame:
+    path = DATA_DIR / f"{symbol}_MARK_1H.csv"
+    mark = read_csv_before_cutoff(
+        path, time_col="datetime", usecols=["datetime", "close"]
+    )
+    mark["close"] = pd.to_numeric(mark["close"], errors="coerce")
+    if mark["datetime"].duplicated().any():
+        raise ValueError(f"{path.name} has duplicate hourly bars")
+    return mark.rename(columns={"datetime": "ts", "close": "mark_close"})
+
+
+def build_oi_features(symbol: str, mark: pd.DataFrame) -> pd.DataFrame:
+    metrics_path = DATA_DIR / f"{symbol}_METRICS_5M.csv"
+    metrics = read_csv_before_cutoff(
+        metrics_path,
+        time_col="create_time",
+        usecols=["create_time", "sum_open_interest_value"],
+    )
+    hourly = resample_last_observation(
+        metrics,
+        time_col="create_time",
+        value_col="sum_open_interest_value",
+    ).rename(columns={"sum_open_interest_value": "oi_notional"})
+    hourly["d6h_pct"] = hourly["oi_notional"].pct_change(6, fill_method=None)
+    rolled = add_rolling_midrank(
+        hourly,
+        time_col="ts",
+        value_col="d6h_pct",
+    ).rename(columns={"rolling_pctl": "d6h_rolling_pctl"})
+
+    joined = rolled.merge(mark, on="ts", how="left", validate="one_to_one")
+    joined["r6h_mark"] = np.log(
+        joined["mark_close"] / joined["mark_close"].shift(6)
+    )
+    joined["symbol"] = symbol
+    return joined
+
+
+def funding_percentiles(symbol: str) -> pd.DataFrame:
+    path = DATA_DIR / f"{symbol}_FUNDING_8H.csv"
+    funding = read_csv_before_cutoff(
+        path,
+        time_col="datetime",
+        usecols=["datetime", "last_funding_rate"],
+    )
+    funding["last_funding_rate"] = pd.to_numeric(
+        funding["last_funding_rate"], errors="coerce"
+    )
+    funding = funding.sort_values("datetime").reset_index(drop=True)
+    times = pd.to_datetime(funding["datetime"], utc=True)
+    values = funding["last_funding_rate"]
+    percentiles = np.full(len(funding), np.nan, dtype=float)
+    left = 0
+    for idx, current_time in enumerate(times):
+        cutoff = current_time - pd.Timedelta(days=365)
+        while left < idx and times.iloc[left] < cutoff:
+            left += 1
+        prior_times = times.iloc[left:idx]
+        prior_values = values.iloc[left:idx].dropna()
+        has_history = (
+            len(prior_times) > 0
+            and prior_times.iloc[0] <= current_time - pd.Timedelta(days=MIN_DAYS)
+        )
+        if has_history and len(prior_values):
+            current = float(values.iloc[idx])
+            lower = int((prior_values < current).sum())
+            equal = int((prior_values == current).sum())
+            percentiles[idx] = (lower + 0.5 * equal) / len(prior_values)
+    funding["funding_rolling_pctl"] = percentiles
+    return funding.rename(
+        columns={
+            "datetime": "funding_time",
+            "last_funding_rate": "funding_value",
+        }
+    )
+
+
+def btc_daily_regime(btc_mark: pd.DataFrame) -> pd.DataFrame:
+    daily = (
+        btc_mark.set_index("ts")["mark_close"]
+        .resample("1D")
+        .last()
+        .rename("daily_close")
+        .to_frame()
+    )
+    daily["sma200"] = daily["daily_close"].rolling(200, min_periods=200).mean()
+    daily["regime"] = np.where(
+        daily["sma200"].isna(),
+        "unknown",
+        np.where(daily["daily_close"] > daily["sma200"], "bull", "bear"),
+    )
+    daily["day"] = daily.index
+    return daily.reset_index(drop=True)
+
+
+def annotate_pre_event_fields(
+    episodes: pd.DataFrame,
+    funding: pd.DataFrame,
+    regimes: pd.DataFrame,
+) -> pd.DataFrame:
+    if episodes.empty:
+        return episodes.copy()
+    event_times = pd.to_datetime(episodes["event_time_utc"], utc=True)
+    funding_times = pd.to_datetime(funding["funding_time"], utc=True)
+    funding_rows: list[dict[str, object]] = []
+    for event_time in event_times:
+        pos = int(funding_times.searchsorted(event_time, side="left")) - 1
+        if pos < 0:
+            funding_rows.append(
+                {
+                    "funding_time_utc": None,
+                    "funding_value": math.nan,
+                    "funding_rolling_pctl": math.nan,
+                    "a2_overlap": None,
+                }
+            )
+            continue
+        row = funding.iloc[pos]
+        percentile = float(row["funding_rolling_pctl"])
+        funding_rows.append(
+            {
+                "funding_time_utc": utc_text(row["funding_time"]),
+                "funding_value": float(row["funding_value"]),
+                "funding_rolling_pctl": percentile,
+                "a2_overlap": int(percentile >= 0.95)
+                if np.isfinite(percentile)
+                else None,
+            }
+        )
+
+    annotated = pd.concat(
+        [episodes.reset_index(drop=True), pd.DataFrame(funding_rows)], axis=1
+    )
+    regime_map = regimes.set_index("day")["regime"]
+    prior_days = event_times.floor("D") - pd.Timedelta(days=1)
+    annotated["regime"] = prior_days.map(regime_map).fillna("unknown").to_numpy()
+    return annotated
+
+
+def build_symbol_episodes(
+    symbol: str,
+    mark: pd.DataFrame,
+    regimes: pd.DataFrame,
+) -> pd.DataFrame:
+    features = build_oi_features(symbol, mark)
+    triggered = features.loc[trigger_mask(features)].copy()
+    triggered = triggered.rename(columns={"ts": "event_time_utc"})
+    triggered = apply_refractory(triggered, time_col="event_time_utc")
+    severity = triggered["d6h_rolling_pctl"].map(severity_code)
+    triggered["severity"] = severity.map(lambda item: item[0])
+    triggered["severity_code"] = severity.map(lambda item: item[1])
+    episodes = triggered.loc[
+        :,
+        [
+            "event_time_utc",
+            "symbol",
+            "oi_notional",
+            "d6h_pct",
+            "d6h_rolling_pctl",
+            "r6h_mark",
+            "severity",
+            "severity_code",
+        ],
+    ].copy()
+    episodes["event_time_utc"] = episodes["event_time_utc"].map(utc_text)
+    return annotate_pre_event_fields(
+        episodes,
+        funding_percentiles(symbol),
+        regimes,
+    ).loc[:, EPISODE_COLUMNS]
+
+
+def build_all_episodes() -> pd.DataFrame:
+    marks = {symbol: load_mark_buckets(symbol) for symbol in SYMBOLS}
+    regimes = btc_daily_regime(marks["BTCUSDT"])
+    episodes = pd.concat(
+        [
+            build_symbol_episodes(symbol, marks[symbol], regimes)
+            for symbol in SYMBOLS
+        ],
+        ignore_index=True,
+    )
+    return episodes.sort_values(
+        ["event_time_utc", "symbol"], kind="mergesort"
+    ).reset_index(drop=True)
+
+
+def git_head() -> str:
+    return subprocess.run(
+        ["git", "rev-parse", "HEAD"],
+        cwd=ROOT,
+        check=True,
+        capture_output=True,
+        text=True,
+    ).stdout.strip()
+
+
+def preflight_key_directory(key_path: Path = DEFAULT_KEY_PATH) -> None:
+    try:
+        key_path.relative_to(ROOT)
+    except ValueError:
+        pass
+    else:
+        raise RuntimeError("sealed key path must be outside the project")
+    key_path.parent.mkdir(parents=True, mode=0o700, exist_ok=True)
+    if key_path.exists():
+        raise FileExistsError(f"refusing to overwrite existing key: {key_path}")
+
+
+def write_key_exclusive(key_path: Path, key: bytes) -> None:
+    descriptor = os.open(
+        key_path,
+        os.O_WRONLY | os.O_CREAT | os.O_EXCL,
+        0o600,
+    )
+    try:
+        with os.fdopen(descriptor, "wb") as handle:
+            handle.write(key)
+            handle.flush()
+            os.fsync(handle.fileno())
+    except Exception:
+        key_path.unlink(missing_ok=True)
+        raise
+
+
+def seal_episodes(episodes: pd.DataFrame) -> dict[str, object]:
+    preflight_key_directory()
+    if any(path.exists() for path in (WORK_EPISODES_PATH, SEALED_PATH, MANIFEST_PATH)):
+        raise FileExistsError("refusing to overwrite existing A1_WORK artifacts")
+
+    work, sealed = split_every_fifth(episodes)
+    work_bytes = dataframe_csv_bytes(work)
+    sealed_plaintext = dataframe_csv_bytes(sealed)
+    key_buffer = bytearray(os.urandom(32))
+    nonce = os.urandom(12)
+    encrypted = encrypt_aes_gcm(sealed_plaintext, bytes(key_buffer), nonce)
+
+    WORK_DIR.mkdir(parents=True, exist_ok=True)
+    write_key_exclusive(DEFAULT_KEY_PATH, bytes(key_buffer))
+    WORK_EPISODES_PATH.write_bytes(work_bytes)
+    SEALED_PATH.write_bytes(encrypted)
+
+    manifest = {
+        "generated_at_utc": utc_text(pd.Timestamp.now(tz="UTC")),
+        "custodian": "main session / independent custodian principal",
+        "cutoff_exclusive_utc": utc_text(CUTOFF),
+        "sort": ["event_time_utc", "symbol"],
+        "split_rule": "every fifth row (1-based) is sealed",
+        "work_rows": int(len(work)),
+        "sealed_rows": int(len(sealed)),
+        "schema": EPISODE_COLUMNS,
+        "git_hash": git_head(),
+        "work_plaintext_sha256": sha256_bytes(work_bytes),
+        "sealed_plaintext_sha256": sha256_bytes(sealed_plaintext),
+        "sealed_ciphertext_sha256": sha256_bytes(encrypted),
+        "sealed_format": "12-byte nonce || ciphertext || 16-byte GCM tag",
+        "key_location": str(DEFAULT_KEY_PATH),
+        "unseal_condition": "Tier A PASS and Founder approval",
+        "one_time_use": {
+            "used": False,
+            "used_at_utc": None,
+            "authorized_by": None,
+        },
+    }
+    MANIFEST_PATH.write_text(
+        json.dumps(manifest, ensure_ascii=False, indent=2) + "\n",
+        encoding="utf-8",
+    )
+
+    # Custodian phase ends here. Drop all sealed plaintext and key variables;
+    # the executor is a separate process and must never reload either.
+    sealed.drop(sealed.index, inplace=True)
+    for idx in range(len(key_buffer)):
+        key_buffer[idx] = 0
+    del sealed, sealed_plaintext, key_buffer, encrypted
+    gc.collect()
+    return manifest
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument(
+        "--custodian",
+        action="store_true",
+        help="acknowledge that this process is the independent custodian",
+    )
+    args = parser.parse_args()
+    if not args.custodian:
+        raise SystemExit("--custodian is required")
+    preflight_key_directory()
+    episodes = build_all_episodes()
+    manifest = seal_episodes(episodes)
+    print(json.dumps(manifest, ensure_ascii=False, indent=2))
+
+
+if __name__ == "__main__":
+    main()
