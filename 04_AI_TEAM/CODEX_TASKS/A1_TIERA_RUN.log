+DATA_DIR = ROOT / "06_RESEARCH" / "DATA" / "FUTURES"
+WORK_DIR = ROOT / "06_RESEARCH" / "DATA" / "A1_WORK"
+OUTPUT_DIR = ROOT / "06_RESEARCH" / "CODE" / "output"
+RESULTS_DIR = ROOT / "06_RESEARCH" / "RESULTS"
+
+SYMBOLS = ("BTCUSDT", "ETHUSDT", "SOLUSDT")
+CUTOFF = pd.Timestamp("2024-12-10T00:00:00Z")
+WINDOW_DAYS = 365
+MIN_DAYS = 180
+MIN_OI_SAMPLES = 720
+REFRACTORY_HOURS = 24
+BLOCK_HOURS = 144
+BOOTSTRAP_REPS = 10_000
+SEED = 20_260_615
+HORIZONS = (24, 48, 72)
+
+WORK_EPISODES_PATH = WORK_DIR / "work_episodes.csv"
+SEALED_PATH = WORK_DIR / "sealed_holdout.enc"
+MANIFEST_PATH = WORK_DIR / "A1_HOLDOUT_MANIFEST.json"
+PERMTEST_PATH = WORK_DIR / "A1_HOLDOUT_PERMTEST.log"
+DEFAULT_KEY_PATH = Path.home() / ".aiquant_sealed" / "a1" / "a1_key.bin"
+
+
+def assert_not_restricted_path(path: str | Path) -> None:
+    """Reject sealed episode and pre-existing holdout data paths."""
+    lowered = str(Path(path)).lower()
+    forbidden = ("sealed_holdout", "data/holdout", "data\\holdout", "a2_events_holdout")
+    if any(token in lowered for token in forbidden):
+        raise AssertionError(f"restricted path access is forbidden: {path}")
+
+
+def parse_utc(value: object) -> pd.Timestamp:
+    return pd.Timestamp(value).tz_localize("UTC") if pd.Timestamp(value).tzinfo is None else pd.Timestamp(value).tz_convert("UTC")
+
+
+def utc_text(value: object) -> str:
+    return parse_utc(value).strftime("%Y-%m-%dT%H:%M:%SZ")
+
+
+def sha256_bytes(payload: bytes) -> str:
+    return hashlib.sha256(payload).hexdigest()
+
+
+def dataframe_csv_bytes(frame: pd.DataFrame) -> bytes:
+    text = frame.to_csv(index=False, lineterminator="\n")
+    return text.encode("utf-8")
+
+
+def read_csv_before_cutoff(
+    path: Path,
+    *,
+    time_col: str,
+    usecols: Sequence[str],
+    cutoff: pd.Timestamp = CUTOFF,
+) -> pd.DataFrame:
+    """Stream a sorted CSV and stop before the first cutoff-or-later row."""
+    assert_not_restricted_path(path)
+    rows: list[dict[str, str]] = []
+    cutoff_naive = cutoff.tz_convert(None).to_pydatetime()
+    with path.open("r", encoding="utf-8", newline="") as handle:
+        reader = csv.DictReader(handle)
+        missing = set(usecols).difference(reader.fieldnames or ())
+        if missing:
+            raise ValueError(f"{path.name} missing columns: {sorted(missing)}")
+        previous: datetime | None = None
+        for raw in reader:
+            current = datetime.fromisoformat(raw[time_col].replace("Z", "+00:00"))
+            if current.tzinfo is not None:
+                current = current.replace(tzinfo=None)
+            if previous is not None and current < previous:
+                raise ValueError(f"{path.name} is not sorted by {time_col}")
+            previous = current
+            if current >= cutoff_naive:
+                break
+            rows.append({column: raw[column] for column in usecols})
+    frame = pd.DataFrame(rows, columns=usecols)
+    if not frame.empty:
+        frame[time_col] = pd.to_datetime(frame[time_col], utc=True)
+    return frame
+
+
+def resample_last_observation(
+    frame: pd.DataFrame,
+    *,
+    time_col: str,
+    value_col: str,
+) -> pd.DataFrame:
+    """Return a complete UTC hourly grid using the last row in each hour."""
+    data = frame.loc[:, [time_col, value_col]].copy()
+    data[time_col] = pd.to_datetime(data[time_col], utc=True)
+    data[value_col] = pd.to_numeric(data[value_col], errors="coerce")
+    data["ts"] = data[time_col].dt.floor("h")
+    last = data.sort_values(time_col).groupby("ts", sort=True).tail(1).set_index("ts")[value_col]
+    grid = pd.date_range(last.index.min(), last.index.max(), freq="h", tz="UTC")
+    return last.reindex(grid).rename(value_col).rename_axis("ts").reset_index()
+
+
+def add_rolling_midrank(
+    frame: pd.DataFrame,
+    *,
+    time_col: str,
+    value_col: str,
+    min_distinct_days: int = MIN_DAYS,
+    min_samples: int = MIN_OI_SAMPLES,
+    window_days: int = WINDOW_DAYS,
+) -> pd.DataFrame:
+    """Compute prior-only rolling midranks with the v5 validity predicate."""
+    data = frame.sort_values(time_col).reset_index(drop=True).copy()
+    times = pd.to_datetime(data[time_col], utc=True)
+    values = pd.to_numeric(data[value_col], errors="coerce")
+    active: deque[tuple[pd.Timestamp, float]] = deque()
+    sorted_values: list[float] = []
+    day_counts: Counter[object] = Counter()
+    percentiles = np.full(len(data), np.nan, dtype=float)
+    sample_counts = np.zeros(len(data), dtype=int)
+    distinct_days = np.zeros(len(data), dtype=int)
+    window = pd.Timedelta(days=window_days)
+
+    for idx, current_time in enumerate(times):
+        cutoff = current_time - window
+        while active and active[0][0] < cutoff:
+            old_time, old_value = active.popleft()
+            position = bisect.bisect_left(sorted_values, old_value)
+            if position >= len(sorted_values) or sorted_values[position] != old_value:
+                raise RuntimeError("rolling percentile state is inconsistent")
+            sorted_values.pop(position)
+            old_day = old_time.date()
+            day_counts[old_day] -= 1
+            if day_counts[old_day] == 0:
+                del day_counts[old_day]
+
+        sample_counts[idx] = len(sorted_values)
+        distinct_days[idx] = len(day_counts)
+        current_value = values.iloc[idx]
+        if (
+            pd.notna(current_value)
+            and len(sorted_values) >= min_samples
+            and len(day_counts) >= min_distinct_days
+        ):
+            lower = bisect.bisect_left(sorted_values, float(current_value))
+            upper = bisect.bisect_right(sorted_values, float(current_value))
+            percentiles[idx] = (lower + 0.5 * (upper - lower)) / len(sorted_values)
+
+        if pd.notna(current_value):
+            numeric = float(current_value)
+            bisect.insort(sorted_values, numeric)
+            active.append((current_time, numeric))
+            day_counts[current_time.date()] += 1
+
+    data["rolling_pctl"] = percentiles
+    data["window_valid_samples"] = sample_counts
+    data["window_distinct_days"] = distinct_days
+    data["warmup"] = np.isnan(percentiles)
+    return data
+
+
+def trigger_mask(features: pd.DataFrame) -> pd.Series:
+    required = {"d6h_rolling_pctl", "r6h_mark"}
+    missing = required.difference(features.columns)
+    if missing:
+        raise ValueError(f"trigger features missing columns: {sorted(missing)}")
+    return (features["d6h_rolling_pctl"] <= 0.01) & (features["r6h_mark"] < 0)
+
+
+def apply_refractory(
+    triggers: pd.DataFrame,
+    *,
+    time_col: str = "event_time_utc",
+    refractory_hours: int = REFRACTORY_HOURS,
+) -> pd.DataFrame:
+    """Keep the first trigger, then allow the next at least 24h later."""
+    if triggers.empty:
+        return triggers.copy()
+    ordered = triggers.copy()
+    ordered[time_col] = pd.to_datetime(ordered[time_col], utc=True)
+    ordered = ordered.sort_values(time_col, kind="mergesort")
+    kept: list[int] = []
+    last_event: pd.Timestamp | None = None
+    refractory = pd.Timedelta(hours=refractory_hours)
+    for idx, row in ordered.iterrows():
+        event_time = row[time_col]
+        if last_event is None or event_time >= last_event + refractory:
+            kept.append(idx)
+            last_event = event_time
+    return ordered.loc[kept].reset_index(drop=True)
+
+
+def split_every_fifth(episodes: pd.DataFrame) -> tuple[pd.DataFrame, pd.DataFrame]:
+    ordered = episodes.sort_values(
+        ["event_time_utc", "symbol"], kind="mergesort"
+    ).reset_index(drop=True)
+    sealed_mask = (np.arange(len(ordered)) + 1) % 5 == 0
+    return (
+        ordered.loc[~sealed_mask].reset_index(drop=True),
+        ordered.loc[sealed_mask].reset_index(drop=True),
+    )
+
+
+def severity_code(percentile: float) -> tuple[str, int]:
+    if percentile <= 0.0033:
+        return "Severe", 2
+    if percentile <= 0.0067:
+        return "Medium", 1
+    if percentile <= 0.01:
+        return "Mild", 0
+    raise ValueError("severity percentile is outside the frozen trigger range")
+
+
+def encrypt_aes_gcm(plaintext: bytes, key: bytes, nonce: bytes) -> bytes:
+    if len(key) != 32:
+        raise ValueError("AES-256-GCM requires a 32-byte key")
+    if len(nonce) != 12:
+        raise ValueError("AES-GCM nonce must be 12 bytes")
+    return nonce + AESGCM(key).encrypt(nonce, plaintext, None)
+
+
+def decrypt_aes_gcm(payload: bytes, key: bytes) -> bytes:
+    if len(payload) < 28:
+        raise ValueError("sealed payload is too short")
+    if len(key) != 32:
+        raise ValueError("AES-256-GCM requires a 32-byte key")
+    nonce = payload[:12]
+    ciphertext_and_tag = payload[12:]
+    return AESGCM(key).decrypt(nonce, ciphertext_and_tag, None)
+
+
+class CircularBlockSampler:
+    """Circular UTC-hour moving-block sampler frozen by preregistration v5."""
+
+    def __init__(self, times: Iterable[object], block_hours: int = BLOCK_HOURS):
+        parsed = pd.DatetimeIndex(pd.to_datetime(list(times), utc=True))
+        if len(parsed) == 0:
+            raise ValueError("at least one episode is required")
+        if not parsed.is_monotonic_increasing:
+            raise ValueError("episode times must be sorted")
+        offsets = ((parsed - parsed[0]) / pd.Timedelta(hours=1)).to_numpy()
+        if not np.allclose(offsets, np.round(offsets)):
+            raise ValueError("episode times must lie on the UTC hourly grid")
+        self.event_offsets = np.round(offsets).astype(int)
+        self.span_hours = int(self.event_offsets[-1]) + 1
+        self.block_hours = int(block_hours)
+        if self.block_hours <= 0:
+            raise ValueError("block_hours must be positive")
+        self.blocks: list[np.ndarray] = []
+        for start in range(self.span_hours):
+            circular = (self.event_offsets - start) % self.span_hours
+            members = np.flatnonzero(circular < self.block_hours)
+            if len(members):
+                members = members[np.argsort(circular[members], kind="stable")]
+            self.blocks.append(members.astype(int))
+
+    def sample_indices(
+        self,
+        rng: np.random.Generator,
+        *,
+        sample_size: int | None = None,
+        start_offsets: Iterator[int] | None = None,
+    ) -> np.ndarray:
+        target = len(self.event_offsets) if sample_size is None else int(sample_size)
+        if target <= 0:
+            raise ValueError("sample_size must be positive")
+        sampled: list[int] = []
+        attempts = 0
+        while len(sampled) < target:
+            if start_offsets is None:
+                start = int(rng.integers(0, self.span_hours))
+            else:
+                start = int(next(start_offsets)) % self.span_hours
+            block = self.blocks[start]
+            attempts += 1
+            if len(block) == 0:
+                if attempts > self.span_hours * target * 10:
+                    raise RuntimeError("unable to draw a non-empty circular block")
+                continue
+            remaining = target - len(sampled)
+            sampled.extend(block[:remaining].tolist())
+        return np.asarray(sampled, dtype=int)
+
+
+def moving_block_mean_test(
+    times: Sequence[object],
+    values: Sequence[float],
+    *,
+    seed: int = SEED,
+    reps: int = BOOTSTRAP_REPS,
+    block_hours: int = BLOCK_HOURS,
+) -> dict[str, object]:
+    numeric = np.asarray(values, dtype=float)
+    if len(numeric) == 0 or np.isnan(numeric).any():
+        return {"status": "N.A.", "n": int(len(numeric))}
+    sampler = CircularBlockSampler(times, block_hours)
+    observed = float(numeric.mean())
+    rng = np.random.default_rng(seed)
+    means = np.empty(reps, dtype=float)
+    for idx in range(reps):
+        sampled = sampler.sample_indices(rng)
+        means[idx] = float(numeric[sampled].mean())
+    centered = means - observed
+    p_value = float((np.count_nonzero(centered >= observed) + 1) / (reps + 1))
+    lower_q, upper_q = np.quantile(means, [0.025, 0.975])
+    return {
+        "status": "OK",
+        "n": int(len(numeric)),
+        "mean": observed,
+        "p_raw": p_value,
+        "ci95_basic": [float(2 * observed - upper_q), float(2 * observed - lower_q)],
+        "bootstrap_reps": int(reps),
+        "seed": int(seed),
+        "block_hours": int(block_hours),
+    }
+
+
+def spearman_midrank(x: Sequence[float], y: Sequence[float]) -> float:
+    if len(x) < 2 or len(y) < 2:
+        return math.nan
+    x_rank = pd.Series(x, dtype=float).rank(method="average").to_numpy()
+    y_rank = pd.Series(y, dtype=float).rank(method="average").to_numpy()
+    if np.std(x_rank) == 0 or np.std(y_rank) == 0:
+        return math.nan
+    return float(np.corrcoef(x_rank, y_rank)[0, 1])
+
+
+def moving_block_spearman_test(
+    times: Sequence[object],
+    severity: Sequence[float],
+    values: Sequence[float],
+    *,
+    seed: int = SEED,
+    reps: int = BOOTSTRAP_REPS,
+    block_hours: int = BLOCK_HOURS,
+) -> dict[str, object]:
+    x = np.asarray(severity, dtype=float)
+    y = np.asarray(values, dtype=float)
+    observed = spearman_midrank(x, y)
+    if len(x) == 0 or not np.isfinite(observed):
+        return {"status": "N.A.", "n": int(len(x)), "rho": None}
+    sampler = CircularBlockSampler(times, block_hours)
+    rng = np.random.default_rng(seed)
+    boot = np.empty(reps, dtype=float)
+    for idx in range(reps):
+        sampled = sampler.sample_indices(rng)
+        boot[idx] = spearman_midrank(x[sampled], y[sampled])
+    if np.isnan(boot).any():
+        return {
+            "status": "N.A.",
+            "n": int(len(x)),
+            "rho": observed,
+            "reason": "undefined Spearman bootstrap replicate",
+        }
+    p_value = float((np.count_nonzero((boot - observed) >= observed) + 1) / (reps + 1))
+    return {
+        "status": "OK",
+        "n": int(len(x)),
+        "rho": observed,
+        "p_raw": p_value,
+        "bootstrap_reps": int(reps),
+        "seed": int(seed),
+        "block_hours": int(block_hours),
+    }
+
+
+def holm_adjust(p_values: dict[str, float | None], alpha: float = 0.05) -> dict[str, dict[str, object]]:
+    """Holm-adjust a fixed family; missing values remain N.A."""
+    finite = [(name, float(value)) for name, value in p_values.items() if value is not None and np.isfinite(value)]
+    ordered = sorted(finite, key=lambda item: (item[1], item[0]))
+    family_size = len(p_values)
+    adjusted: dict[str, float] = {}
+    running = 0.0
+    for rank, (name, raw) in enumerate(ordered):
+        candidate = min(1.0, (family_size - rank) * raw)
+        running = max(running, candidate)
+        adjusted[name] = running
+    result: dict[str, dict[str, object]] = {}
+    for name, raw in p_values.items():
+        if name not in adjusted:
+            result[name] = {"p_raw": raw, "p_holm": None, "significant": None}
+        else:
+            result[name] = {
+                "p_raw": float(raw),
+                "p_holm": adjusted[name],
+                "significant": bool(adjusted[name] <= alpha),
+            }
+    return result
+
+
+def dataframe_from_csv_bytes(payload: bytes) -> pd.DataFrame:
+    return pd.read_csv(io.BytesIO(payload))
