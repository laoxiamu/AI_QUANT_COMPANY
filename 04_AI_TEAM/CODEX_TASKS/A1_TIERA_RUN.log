+)
+
+
+EPISODE_COLUMNS = [
+    "event_time_utc",
+    "symbol",
+    "oi_notional",
+    "d6h_pct",
+    "d6h_rolling_pctl",
+    "r6h_mark",
+    "severity",
+    "severity_code",
+    "funding_time_utc",
+    "funding_value",
