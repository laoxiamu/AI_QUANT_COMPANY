+
+
+def bool_count(series: pd.Series) -> int | None:
+    """Count True values only when no network-indeterminate rows exist."""
+    if series.isna().any():
+        return None
+    return int(series.sum())
+
+
+def md_table(headers: list[str], rows: list[list[object]]) -> str:
