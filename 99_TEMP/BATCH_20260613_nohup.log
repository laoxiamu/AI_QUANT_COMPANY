+    write_outputs(csv_frame, audit, generated_at)
+    if csv_frame[["head_first_ok", "head_recent_ok"]].isna().any(axis=None):
+        return 2
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
